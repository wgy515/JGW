<?xml version="1.0" encoding="utf-8"?>
<root>
  <StationConfigSession>
	<TesterName>QSEQ_Sample1</TesterName>
	<TesterType>QSEQ</TesterType>
	<DomainName>Sample</DomainName>
  </StationConfigSession>
  <DeviceConfigSession>
    <!--Valid tag: DLL, XTT, or absolute path to any directory-->
	<SequencePathRelativeTo>XTT</SequencePathRelativeTo>
    <!--valid tag: %DATE_TIME%-->
    <SequenceLogFileNameTemplate>%DATE_TIME%_QSEQ_Log_ConsoleApp.txt</SequenceLogFileNameTemplate>
    <XMLLogStyleSheet>..\databases\HTML_QDART_Combined.xsl</XMLLogStyleSheet>
    <!--valid tag: %DATE_TIME% %DEVICE_GROUP_ID%-->
    <XMLLogFileNameTemplate>%DATE_TIME%_QSEQ_Output_DeviceGroup_%DEVICE_GROUP_ID%</XMLLogFileNameTemplate>
    <Libraries>
      <DLL>QSEQ_Utility_Qualcomm.dll</DLL>
      <DLL>QSEQ_PathLossManager.dll</DLL>
      <DLL>QSEQ_Algorithm_Qualcomm_RFVFS.dll</DLL>
      <DLL>QSEQ_Device_Qualcomm_Mobile_RFVFS.dll</DLL>
      <DLL>QSEQ_Device_Keysight_EXx_RFVFS.dll</DLL>
    </Libraries>
    <DeviceGroups>
      <DeviceGroup ID="1">
        <Resources>
          <Resource name ="QSEQ_RESOURCE_PATHLOSSMANAGER" config="..\Databases\CalDB_NET.xml"></Resource>
        </Resources>
        <!--valid tag: %DATE_TIME% %DEVICE_GROUP_ID%-->
        <DeviceLogFileNameTemplate>%DATE_TIME%_QSEQ_Log_DeviceGroup_1.txt</DeviceLogFileNameTemplate>
        <Device ID="1" NOTINUSE="false" UUT="True">
          <Type>QSEQ_DEVICE_QUALCOMM_MOBILE</Type>
          <ConfigString>CONNECT=QPST:-1:TIMEOUT_SEC:60</ConfigString>
          <!-- ConfigString Format: "CONNECT=diag_transport_mode:comm_port" -->
          <!-- where diag_transport_mode = "QPST", "QPHONEMS", or "USER_DEFINED" -->
          <!-- where comm_port = the COMM port (numeric value) ("-1" for AUTO select or actual COMM port id number -->
        </Device>
		
        <Device ID="3" NOTINUSE="false" UUT="False">
 		  <Type>QSEQ_DEVICE_Keysight_EXx</Type>	  
          <ConfigString>VISA=TCPIP0::A-E6640A-50455::inst0::INSTR|RF_PORT_ID=RFIO1</ConfigString>
        </Device>
          <!-- ConfigString Format: device dependent -->
          <!-- Agilent EXT/EXM Example Format: "VISA=equipment_connection_string|RF_PORT_ID=equipment_rf_port" ("|" delimited) -->
          <!-- where equipment_connection_string = VISA alias or address -->
          <!-- where RF_PORT_ID = the EXT/EXM RFIO Port ID string for Tx/Rx port. If support for multiple ports are needed, use the multiplex manager -->
      </DeviceGroup>
    </DeviceGroups>
  </DeviceConfigSession>
</root>
