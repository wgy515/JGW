<?xml version="1.0" encoding="utf-8"?>
<root>
  <StationConfigSession>
  <TesterName>QSEQ_Sample1</TesterName>
  <TesterType>QSEQ</TesterType>
  <DomainName>Sample</DomainName>
  </StationConfigSession>
  <DeviceConfigSession>
    <!--Valid tag: DLL, XTT, or absolute path to any directory-->
  <SequencePathRelativeTo>XTT</SequencePathRelativeTo>
    <!--valid tag: %DATE_TIME%-->
    <SequenceLogFileNameTemplate>%SN%_%DATE_TIME%_QSEQ_Log_ConsoleApp.txt</SequenceLogFileNameTemplate>
    <XMLLogStyleSheet>..\databases\HTML_QDART_Combined.xsl</XMLLogStyleSheet>
    <!--valid tag: %SN% %DATE_TIME% %DEVICE_GROUP_ID%-->
    <XMLLogFileNameTemplate>%SN%_%DATE_TIME%_QSEQ_Output_DeviceGroup_%DEVICE_GROUP_ID%</XMLLogFileNameTemplate>
    <Libraries>
      <DLL>QSEQ_Utility_Qualcomm.dll</DLL>
      <DLL>QSEQ_PathLossManager.dll</DLL>
      <DLL>QSEQ_Algorithm_Qualcomm_NSVFS.dll</DLL>
      <DLL>QSEQ_Device_Qualcomm_Mobile.dll</DLL>
      <DLL>QSEQ_Device_LitePoint_IQxstream.dll</DLL>
    </Libraries>
    <DeviceGroups>
      <DeviceGroup ID="1">
        <Resources>
          <Resource name ="QSEQ_RESOURCE_PATHLOSSMANAGER" config="..\Databases\calDB_NET.xml"></Resource>
        </Resources>
        <!--valid tag: %DATE_TIME% %DEVICE_GROUP_ID%-->
        <DeviceLogFileNameTemplate>%SN%_%DATE_TIME%_QSEQ_Log_DeviceGroup_1.txt</DeviceLogFileNameTemplate>
        <Device ID="1" NOTINUSE="false" UUT="True">
          <Type>QSEQ_DEVICE_QUALCOMM_MOBILE</Type>
          <ConfigString>CONNECT=QPST:-1:TIMEOUT_SEC:60</ConfigString>
          <!-- ConfigString Format: "CONNECT=diag_transport_mode:comm_port" -->
          <!-- where diag_transport_mode = "QPST", "QPHONEMS", or "USER_DEFINED" -->
          <!-- where comm_port = the COMM port (numeric value) ("-1" for AUTO select or actual COMM port id number -->
        </Device>
        <Device ID="8" NOTINUSE="false" UUT="False">
          <Type>QSEQ_DEVICE_LITEPOINT_IQXSTREAM</Type>
          <ConfigString>CONNECT=TCPIP0::iqxs0000::24100::SOCKET|RF_PORT_ID=RF1</ConfigString>
          <!-- ConfigString Format: device dependent -->
          <!-- LitePoint IQxs Example Format: "CONNECT=equipment_connection_string|RF_PORT_ID=equipment_rf_port" ("|" delimited) -->
          <!-- where equipment_connection_string = NI-488 (GPIB) NI standard connection string for TCP/IP -->
		  <!-- where RF_PORT_ID = the IQxstream RF Port ID string for Tx/Rx port. If support for multiple ports are needed, use the multiplex manager -->
          <!-- optional arg: ENABLE_PATHLOSS=FALSE to skip over pathloss correction -->
          <!-- optional arg: SEQUENCE_TIMESTAMPS=TRUE to print timestamps in log file for debugging purposes -->
          <!-- optional arg: USE_TEST_PLAN_REFERENCE_LEVEL=TRUE to use test plan-provided values instead of internal logic -->
          <!--
          <MULTIPLEX_MANAGER_CONFIG_FILE>C:\Program Files (x86)\Qualcomm\QDART\databases\MultiplexManagerConfigFile.xml</MULTIPLEX_MANAGER_CONFIG_FILE>
          -->
          <!-- Multiplex Manager configuration when using RF switching -->
        </Device>
      </DeviceGroup>
    </DeviceGroups>
  </DeviceConfigSession>
</root>
