		<Command input="SOURce:GPRF:GEN:STATe ON; *OPC?" find_output="" timeout_sec="1"/>
		<Command input="SOURce:GPRF:GEN:STATe?" find_output="ON" timeout_sec="1"/>
	</CommandGroup>
	<CommandGroup name="rx_exit">
		<Command input="SOURce:GPRF:GEN:STATe OFF; *OPC?" find_output="" timeout_sec="1"/>
		<Command input="SOURce:GPRF:GEN:STATe?" find_output="OFF" timeout_sec="1"/>
