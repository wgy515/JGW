	<CommandGroup name="rx_init">
		<Command input="*CLS;*OPC?;:SYST:ERR?;" find_output="1;0" timeout_sec="1"/>
		<Command input="SOURce:GPRF:GEN:STATe OFF; *OPC?" find_output="" timeout_sec="1"/>
