							<DynamicAttributeValue source="Rx2PathIndex" attributeName="NR_RX2_PATH_INDEX" />
							<DynamicAttributeValue source="Rx2SignalPath" attributeName="NR_RX2_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx2AntPath" attributeName="NR_RX2_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx2PllId" attributeName="NR_RX2_PLL_ID" />
							<DynamicAttributeValue source="Rx2AntNum" attributeName="NR_RX2_ANTENNA_NUMBER" />
