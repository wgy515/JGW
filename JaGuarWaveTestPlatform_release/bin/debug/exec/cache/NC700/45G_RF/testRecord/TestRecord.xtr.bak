							<DynamicAttributeValue source="FreErrDelta" attributeName="WCDMA_MEAS_FREQ_ERROR_LOWER_LIMIT" />
							<DynamicAttributeValue source="SemOOBUpperLimit" attributeName="WCDMA_MEAS_OBW_UPPER_LIMIT" />
							<Attributes>
								<Attribute name="WCDMA_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="WCDMA_RL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="WCDMA_FL_POWER" enabled="true">-60.0</Attribute>
								<Attribute name="WCDMA_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="WCDMA_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="WCDMA_MEAS_EVM_UPPER_LIMIT" enabled="true">17.5</Attribute>
								<Attribute name="WCDMA_MEAS_FREQ_ERROR_UPPER_LIMIT" enabled="true">0.1</Attribute>
								<Attribute name="WCDMA_MEAS_FREQ_ERROR_LOWER_LIMIT" enabled="true">-0.1</Attribute>
								<Attribute name="WCDMA_MEAS_OBW_UPPER_LIMIT" enabled="true">5.0</Attribute>
							</Attributes>
						</Algorithm>
