								<Attribute name="NR_RX1_PATH_INDEX" enabled="true">0</Attribute>
								<Attribute name="NR_RX1_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="NR_RX1_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="NR_RX1_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="NR_RX1_ANTENNA_NUMBER" enabled="true">0</Attribute>
								<Attribute name="NR_RX2_DEVICE" enabled="true">0</Attribute>
