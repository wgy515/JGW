						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_MEASURE">
							<DynamicAttributeValue source="UlPowerLevel" attributeName="WCDMA_RL_POWER" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="WCDMA_RL_POWER_REF_LEVEL" />
