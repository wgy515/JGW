	<SegmentGroups>
		<SegmentGroup ID="LTE_SelfTest">
			<Segments>
				<Segment enabled="true" name="SelfTest Values">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT">
							<DynamicAttributeValue source="SequenceTxSelfTest" attributeName="TX_SELF_TEST_MODE" />
							<DynamicAttributeValue source="SequenceRxSelfTest" attributeName="RX_SELF_TEST_MODE" />
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="TX_SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="TX_SELF_TEST_MEASUREMENTS" enabled="true">POWER,EVM,ACLR,SPECTRAL_FLATNESS,SEM,OBW,VSWR</Attribute>
								<Attribute name="RX_SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="LTE_MEAS_EST_SEN_LOOP_COUNT" enabled="true">7</Attribute>
								<Attribute name="SELF_TEST_MEAS_NUMBER_OF_AVERAGE" enabled="true">1</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_LIMIT" enabled="true">-55.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_EVM_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_ACLR_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_VSWR_LIMIT" enabled="true">-30.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_SPECFLAT_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_SEM_LIMIT" enabled="true">20.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_OBW_LIMIT" enabled="true">20.0</Attribute>
								<Attribute name="LTE_SELF_TEST_DELTA_SPECFLAT_LIMIT" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Config">
			<Segments>
				<Segment enabled="true" name="SequenceControl">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<DynamicAttributeValue source="SequenceTriggerType" attributeName="BASE_COMMON_TRIGGER_TYPE" />
							<DynamicAttributeValue source="SequenceTxSelfTest" attributeName="SELF_TEST_MODE" />
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">0</Attribute>
								<Attribute name="BASE_COMMON_TECH_TYPE" enabled="true">LTE</Attribute>
								<Attribute name="BASE_EQUIP_STARTUP_RESET_INHIBIT" enabled="true">1</Attribute>
								<Attribute name="BASE_MOBILE_MSGS_F3" enabled="true">0</Attribute>
								<Attribute name="BASE_MOBILE_MSGS_L1" enabled="true">0</Attribute>
								<Attribute name="BASE_COMMON_TRIGGER_TYPE" enabled="true">Tx</Attribute>
								<Attribute name="FTM_COMMAND_TIMING_PROFILE" enabled="true">1</Attribute>
								<Attribute name="SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="BASE_COMMON_RX_TRIGGER_THRESHOLD" enabled="true">-65.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Init">
			<Segments>
				<Segment enabled="true" name="Set Initial Radio Configuration">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT">
							<DynamicAttributeValue source="dlCarriers" attributeName="LTE_NUM_DL_CARRIERS" />
							<DynamicAttributeValue source="ulCarriers" attributeName="LTE_NUM_UL_CARRIERS" />
							<DynamicAttributeValue source="NetSigValue" attributeName="LTE_NS_VALUE" />
							<DynamicAttributeValue source="AntPortIteration" attributeName="LTE_ANT_PORT_STATE" />
							<DynamicAttributeValue source="EstSenUpperLimit" attributeName="LTE_MEAS_EST_SEN_UPPERLIMIT" />
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="LTE_NUM_DL_CARRIERS" enabled="true">1</Attribute>
								<Attribute name="LTE_NUM_UL_CARRIERS" enabled="true">1</Attribute>
								<Attribute name="LTE_TX_POWER_AFTER_RADIO_TUNE" enabled="true">1</Attribute>
								<Attribute name="LTE_UL_POWER_REF_HEADROOM" enabled="true">13</Attribute>
								<Attribute name="LTE_UE_MAX_TX_POWER_LIMIT" enabled="true">30</Attribute>
								<Attribute name="LTE_NS_VALUE" enabled="true">1</Attribute>
								<Attribute name="LTE_UL_TX_CHAIN" enabled="true">0</Attribute>
								<Attribute name="LTE_UL_POWER_MAX" enabled="true">23</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
								<Attribute name="LTE_RX_MEASUREMENT_OFFSET_MS" enabled="true">0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="LTE_MEAS_SEM_DELTA_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="LTE_ANT_PORT_STATE" enabled="true">0</Attribute>
								<Attribute name="LTE_MEAS_EST_SEN_UPPERLIMIT" enabled="true">-95.0</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT" repeatForEach="dlCarriers">
							<DynamicAttributeValue source="AlgorithmIteration" attributeName="LTE_CARRIER" />
							<DynamicAttributeValue source="BandNumber" attributeName="LTE_BAND" />
							<DynamicAttributeValue source="BandSubBand" attributeName="LTE_SUB_BAND_ID" />
							<DynamicAttributeValue source="SubBandUlRange" attributeName="LTE_SUB_BAND_UL_CHANNEL_RANGE" />
							<DynamicAttributeValue source="DlChannel" attributeName="LTE_OPT_CHANNEL" />
							<DynamicAttributeValue source="ChBandwidth" attributeName="LTE_CH_BANDWIDTH" />
							<DynamicAttributeValue source="Modulation" attributeName="LTE_MODULATION_TYPE" />
							<DynamicAttributeValue source="UlStartRB" attributeName="LTE_PUSCH_RB_START" />
							<DynamicAttributeValue source="UlNumRB" attributeName="LTE_PUSCH_RB_NUMBER_OF" />
							<DynamicAttributeValue source="BandRxChains" attributeName="LTE_TUNE_NUM_RX_CHAIN" />
							<DynamicAttributeValue source="IsUplinkActive" attributeName="LTE_UPLINK_ACTIVE" />
							<DynamicAttributeValue source="IsContCarrier" attributeName="LTE_INTRA_CONT" />
							<DynamicAttributeValue source="IntraAssocCarrier" attributeName="LTE_INTRA_ASSOC_CARRIER" />
							<DynamicAttributeValue source="BandPowerClass" attributeName="LTE_UE_POWER_CLASS_OVERRIDE" />
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="LTE_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="LTE_BAND" enabled="true">1</Attribute>
								<Attribute name="LTE_SUB_BAND_ID" enabled="true">FULL</Attribute>
								<Attribute name="LTE_SUB_BAND_UL_CHANNEL_RANGE" enabled="true"></Attribute>
								<Attribute name="LTE_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="LTE_CH_BANDWIDTH" enabled="true">10</Attribute>
								<Attribute name="LTE_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="LTE_PUSCH_RB_START" enabled="true">0</Attribute>
								<Attribute name="LTE_PUSCH_RB_NUMBER_OF" enabled="true">50</Attribute>
								<Attribute name="LTE_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">0.0</Attribute>
								<Attribute name="LTE_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="LTE_UPLINK_ACTIVE" enabled="true">true</Attribute>
								<Attribute name="LTE_INTRA_CONT" enabled="true">false</Attribute>
								<Attribute name="LTE_INTRA_ASSOC_CARRIER" enabled="true" />
								<Attribute name="LTE_UE_POWER_CLASS_OVERRIDE" enabled="true">3</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS04_TABLE_VERSION" enabled="true">1</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS05_TABLE_VERSION" enabled="true">2</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS06_TABLE_VERSION" enabled="true">1</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS12_TABLE_VERSION" enabled="true">2</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Path_Config">
			<Segments>
				<Segment enabled="true" name="LTE Set Radio/Path Configuration">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT">
							<DynamicAttributeValue source="UseRecommendedRadioAllocation" attributeName="LTE_USE_RECOMMENDED_RADIO_ALLOCATION" />
							<DynamicAttributeValue source="Rx0Device" attributeName="LTE_RX0_DEVICE" />
							<DynamicAttributeValue source="Rx0SignalPath" attributeName="LTE_RX0_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx0PathIndex" attributeName="LTE_RX0_PATH_INDEX" />
							<DynamicAttributeValue source="Rx0AntPath" attributeName="LTE_RX0_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx0PllId" attributeName="LTE_RX0_PLL_ID" />
							<DynamicAttributeValue source="Rx0AntNum" attributeName="LTE_RX0_ANTENNA_NUMBER" />
							<DynamicAttributeValue source="Rx1Device" attributeName="LTE_RX1_DEVICE" />
							<DynamicAttributeValue source="Rx1PathIndex" attributeName="LTE_RX1_PATH_INDEX" />
							<DynamicAttributeValue source="Rx1SignalPath" attributeName="LTE_RX1_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx1AntPath" attributeName="LTE_RX1_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx1PllId" attributeName="LTE_RX1_PLL_ID" />
							<DynamicAttributeValue source="Rx1AntNum" attributeName="LTE_RX1_ANTENNA_NUMBER" />
							<DynamicAttributeValue source="Rx2Device" attributeName="LTE_RX2_DEVICE" />
							<DynamicAttributeValue source="Rx2PathIndex" attributeName="LTE_RX2_PATH_INDEX" />
							<DynamicAttributeValue source="Rx2SignalPath" attributeName="LTE_RX2_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx2AntPath" attributeName="LTE_RX2_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx2PllId" attributeName="LTE_RX2_PLL_ID" />
							<DynamicAttributeValue source="Rx2AntNum" attributeName="LTE_RX2_ANTENNA_NUMBER" />
							<DynamicAttributeValue source="Rx3Device" attributeName="LTE_RX3_DEVICE" />
							<DynamicAttributeValue source="Rx3PathIndex" attributeName="LTE_RX3_PATH_INDEX" />
							<DynamicAttributeValue source="Rx3SignalPath" attributeName="LTE_RX3_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx3AntPath" attributeName="LTE_RX3_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx3PllId" attributeName="LTE_RX3_PLL_ID" />
							<DynamicAttributeValue source="Rx3AntNum" attributeName="LTE_RX3_ANTENNA_NUMBER" />
							<DynamicAttributeValue source="TxDevice" attributeName="LTE_TX_DEVICE" />
							<DynamicAttributeValue source="TxPathIndex" attributeName="LTE_TX_PATH_INDEX" />
							<DynamicAttributeValue source="TxSignalPath" attributeName="LTE_TX_SIGNAL_PATH" />
							<DynamicAttributeValue source="TxAntPath" attributeName="LTE_TX_ANTENNA_PATH" />
							<DynamicAttributeValue source="TxPllId" attributeName="LTE_TX_PLL_ID" />
							<DynamicAttributeValue source="TxAntNum" attributeName="LTE_TX_ANTENNA_NUMBER" />
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="LTE_USE_RECOMMENDED_RADIO_ALLOCATION" enabled="true">1</Attribute>
								<Attribute name="LTE_TX_DEVICE" enabled="true">0</Attribute>
								<Attribute name="LTE_TX_PATH_INDEX" enabled="true">0</Attribute>
								<Attribute name="LTE_TX_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_TX_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_TX_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="LTE_TX_ANTENNA_NUMBER" enabled="true">0</Attribute>
								<Attribute name="LTE_RX0_DEVICE" enabled="true">0</Attribute>
								<Attribute name="LTE_RX0_PATH_INDEX" enabled="true">0</Attribute>
								<Attribute name="LTE_RX0_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX0_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX0_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="LTE_RX0_ANTENNA_NUMBER" enabled="true">0</Attribute>
								<Attribute name="LTE_RX1_DEVICE" enabled="true">0</Attribute>
								<Attribute name="LTE_RX1_PATH_INDEX" enabled="true">0</Attribute>
								<Attribute name="LTE_RX1_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX1_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX1_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="LTE_RX1_ANTENNA_NUMBER" enabled="true">0</Attribute>
								<Attribute name="LTE_RX2_DEVICE" enabled="true">0</Attribute>
								<Attribute name="LTE_RX2_PATH_INDEX" enabled="true">0</Attribute>
								<Attribute name="LTE_RX2_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX2_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX2_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="LTE_RX2_ANTENNA_NUMBER" enabled="true">0</Attribute>
								<Attribute name="LTE_RX3_DEVICE" enabled="true">0</Attribute>
								<Attribute name="LTE_RX3_PATH_INDEX" enabled="true">0</Attribute>
								<Attribute name="LTE_RX3_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX3_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="LTE_RX3_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="LTE_RX3_ANTENNA_NUMBER" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Freq_Adjust">
			<Segments>
				<Segment enabled="true" name="========== Mobile: Setup for Freq Offset Calc ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT">
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">FREQ_OFFSET_SETUP</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Equip: Compute Mobile Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT">
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">FREQ_OFFSET_COMPUTE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Mobile: Set Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT">
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">FREQ_OFFSET_SET_MOBILE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish LTE FTM RF Call (Start call from PCC) ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_START">
							<Attributes>
								<Attribute name="LTE_ACTIVE_CELL" enabled="true">PCC</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">-25.0</Attribute>
								<Attribute name="LTE_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-20.0</Attribute>
								<Attribute name="LTE_FORCE_LEGACY_FREQ_ADJUST" enabled="true">0</Attribute>
								<Attribute name="LTE_QUERY_UNIFIED_TX_INFO" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">6</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Start_RxTrigger">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish LTE FTM RF Call (Start call from PCC) ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_START">
							<Attributes>
								<Attribute name="LTE_ACTIVE_CELL" enabled="true">PCC</Attribute>
								<Attribute name="LTE_NS_VALUE" enabled="true">1</Attribute>
								<Attribute name="LTE_DL_POWER" enabled="true">-95.0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="LTE_DL_CW_OFFSET" enabled="true">2000</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Dummy Segment for Synchronization ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">150</Attribute>
								<Attribute name="LTE_DUMMY_SEGMENT" enabled="true">1</Attribute>
								<Attribute name="LTE_DL_POWER" enabled="true">-95.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">10</Attribute>
								<Attribute name="LTE_DL_POWER" enabled="true">-60.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Stop">
			<Segments>
				<Segment enabled="true" name="=== Mobile-CallRelease, EQUIP-RfGenOff ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_STOP">
							<Attributes>
								<Attribute name="LTE_ACTION_CALL_RELEASE" enabled="true" />
								<Attribute name="LTE_ACTION_RF_GEN_OFF" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_PreAbstract">
			<Segments>
				<Segment enabled="true" name="Setting power levels before beginning handover">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">10</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">0.0</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_PostAbstract">
			<Segments>
				<Segment enabled="true" name="Setting power levels after running test">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">2</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">0.0</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Handover">
			<Segments>
				<Segment enabled="true" name="Handover Section">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT" repeatForEach="dlCarriers">
							<DynamicAttributeValue source="AlgorithmIteration" attributeName="LTE_CARRIER" />
							<DynamicAttributeValue source="BandNumber" attributeName="LTE_BAND" />
							<DynamicAttributeValue source="BandSubBand" attributeName="LTE_SUB_BAND_ID" />
							<DynamicAttributeValue source="SubBandUlRange" attributeName="LTE_SUB_BAND_UL_CHANNEL_RANGE" />
							<DynamicAttributeValue source="DlChannel" attributeName="LTE_OPT_CHANNEL" />
							<DynamicAttributeValue source="ChBandwidth" attributeName="LTE_CH_BANDWIDTH" />
							<DynamicAttributeValue source="BandRxChains" attributeName="LTE_TUNE_NUM_RX_CHAIN" />
							<DynamicAttributeValue source="IsUplinkActive" attributeName="LTE_UPLINK_ACTIVE" />
							<DynamicAttributeValue source="IsContCarrier" attributeName="LTE_INTRA_CONT" />
							<DynamicAttributeValue source="IntraAssocCarrier" attributeName="LTE_INTRA_ASSOC_CARRIER" />
							<DynamicAttributeValue source="UlStartRB" attributeName="LTE_PUSCH_RB_START" />
							<DynamicAttributeValue source="UlNumRB" attributeName="LTE_PUSCH_RB_NUMBER_OF" />
							<DynamicAttributeValue source="Modulation" attributeName="LTE_MODULATION_TYPE" />
							<DynamicAttributeValue source="BandPowerClass" attributeName="LTE_UE_POWER_CLASS_OVERRIDE" />
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="LTE_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="LTE_BAND" enabled="true">1</Attribute>
								<Attribute name="LTE_SUB_BAND_ID" enabled="true">FULL</Attribute>
								<Attribute name="LTE_SUB_BAND_UL_CHANNEL_RANGE" enabled="true"></Attribute>
								<Attribute name="LTE_TX_POWER_AFTER_RADIO_TUNE" enabled="true">1</Attribute>
								<Attribute name="LTE_CH_BANDWIDTH" enabled="true">10</Attribute>
								<Attribute name="LTE_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="LTE_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
								<Attribute name="LTE_UPLINK_ACTIVE" enabled="true">true</Attribute>
								<Attribute name="LTE_INTRA_CONT" enabled="true">false</Attribute>
								<Attribute name="LTE_INTRA_ASSOC_CARRIER" enabled="true" />
								<Attribute name="LTE_PUSCH_RB_START" enabled="true">38</Attribute>
								<Attribute name="LTE_PUSCH_RB_NUMBER_OF" enabled="true">12</Attribute>
								<Attribute name="LTE_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="LTE_UE_POWER_CLASS_OVERRIDE" enabled="true">3</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS04_TABLE_VERSION" enabled="true">1</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS05_TABLE_VERSION" enabled="true">2</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS06_TABLE_VERSION" enabled="true">1</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_MPR_NS12_TABLE_VERSION" enabled="true">2</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">60</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Measure">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<DynamicAttributeValue source="UlPowerLevel" attributeName="LTE_UL_POWER" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="LTE_UL_POWER_REF_LEVEL" />
							<DynamicAttributeValue source="Modulation" attributeName="LTE_MODULATION_TYPE" />
							<DynamicAttributeValue source="UlStartRB" attributeName="LTE_PUSCH_RB_START" />
							<DynamicAttributeValue source="UlNumRB" attributeName="LTE_PUSCH_RB_NUMBER_OF" />
							<DynamicAttributeValue source="NetSigValue" attributeName="LTE_NS_VALUE" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="LTE_DL_POWER" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="LTE_MEAS_UL_POWER_UPPER_DELTA" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="LTE_MEAS_UL_POWER_LOWER_DELTA" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="LTE_MEAS_RX_LEVEL_LOWER_DELTA" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="LTE_MEAS_RX_LEVEL_UPPER_DELTA" />
							<DynamicAttributeValue source="EstSenUpperLimit" attributeName="LTE_MEAS_EST_SEN_UPPERLIMIT" />
							<DynamicAttributeValue source="EvmUpperLimit" attributeName="LTE_MEAS_TX_EVM_UPPER_LIMIT" />
							<DynamicAttributeValue source="OrgOffUpperLimit" attributeName="LTE_MEAS_TX_ORIGOFFSET_UPPER_LIMIT" />
							<DynamicAttributeValue source="IbeLeakPwrUpperLimit" attributeName="LTE_MEAS_TX_IBE_CARRLEAK_PWR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="LTE_MEAS_TX_FREQERROR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="LTE_MEAS_TX_FREQERROR_LOWER_LIMIT" />
							<DynamicAttributeValue source="SemOOBUpperLimit" attributeName="LTE_MEAS_OBW_UPPER_LIMIT" />
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="LTE_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="LTE_PUSCH_RB_START" enabled="true">38</Attribute>
								<Attribute name="LTE_PUSCH_RB_NUMBER_OF" enabled="true">12</Attribute>
								<Attribute name="LTE_NS_VALUE" enabled="true">1</Attribute>
								<Attribute name="LTE_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="LTE_MEAS_EST_SEN_UPPERLIMIT" enabled="true">-93.0</Attribute>
								<Attribute name="LTE_MEAS_TX_EVM_UPPER_LIMIT" enabled="true">17.5</Attribute>
								<Attribute name="LTE_MEAS_TX_ORIGOFFSET_UPPER_LIMIT" enabled="true">-24.2</Attribute>
								<Attribute name="LTE_MEAS_TX_IBE_CARRLEAK_PWR_UPPER_LIMIT" enabled="true">-24.2</Attribute>
								<Attribute name="LTE_MEAS_TX_FREQERROR_UPPER_LIMIT" enabled="true">0.1</Attribute>
								<Attribute name="LTE_MEAS_TX_FREQERROR_LOWER_LIMIT" enabled="true">-0.1</Attribute>
								<Attribute name="LTE_MEAS_OBW_UPPER_LIMIT" enabled="true">10.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<DynamicAttributeValue source="MeasureUlPower" attributeName="LTE_MEAS_UL_POWER" />
							<DynamicAttributeValue source="MeasureEvm" attributeName="LTE_MEAS_TX_EVM" />
							<DynamicAttributeValue source="MeasureFreqErr" attributeName="LTE_MEAS_TX_FREQERROR" />
							<DynamicAttributeValue source="MeasureSem" attributeName="LTE_MEAS_SEM" />
							<DynamicAttributeValue source="MeasureObw" attributeName="LTE_MEAS_OBW" />
							<DynamicAttributeValue source="MeasureAclr" attributeName="LTE_MEAS_ACLR" />
							<DynamicAttributeValue source="MeasureSpectFlat" attributeName="LTE_MEAS_TX_SPECFLATNESS" />
							<DynamicAttributeValue source="MeasureOrigOffset" attributeName="LTE_MEAS_TX_ORIGOFFSET" />
							<DynamicAttributeValue source="MeasureIbe" attributeName="LTE_MEAS_TX_IBE" />
							<DynamicAttributeValue source="MeasureRxLevel" attributeName="LTE_MEAS_RX_LEVEL" />
							<DynamicAttributeValue source="MeasureSensitivity" attributeName="LTE_MEAS_EST_SEN" />
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER" enabled="true" />
								<Attribute name="LTE_MEAS_TX_FREQERROR" enabled="true" />
								<Attribute name="LTE_MEAS_TX_EVM" enabled="true" />
								<Attribute name="LTE_MEAS_SEM" enabled="true" />
								<Attribute name="LTE_MEAS_OBW" enabled="true" />
								<Attribute name="LTE_MEAS_ACLR" enabled="true" />
								<Attribute name="LTE_MEAS_TX_SPECFLATNESS" enabled="true" />
								<Attribute name="LTE_MEAS_TX_ORIGOFFSET" enabled="true" />
								<Attribute name="LTE_MEAS_TX_IBE" enabled="true" />
								<Attribute name="LTE_MEAS_RX_LEVEL" enabled="true" />
								<Attribute name="LTE_MEAS_EST_SEN" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Measure_Tx">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_INIT" repeatForEach="ulCarriers">
							<DynamicAttributeValue source="AlgorithmIteration" attributeName="LTE_CARRIER" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="LTE_UL_POWER" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="LTE_UL_POWER_REF_LEVEL" />
							<DynamicAttributeValue source="Modulation" attributeName="LTE_MODULATION_TYPE" />
							<DynamicAttributeValue source="UlStartRB" attributeName="LTE_PUSCH_RB_START" />
							<DynamicAttributeValue source="UlNumRB" attributeName="LTE_PUSCH_RB_NUMBER_OF" />
							<Attributes>
								<Attribute name="LTE_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="LTE_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="LTE_UL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="LTE_UL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="LTE_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="LTE_PUSCH_RB_START" enabled="true">38</Attribute>
								<Attribute name="LTE_PUSCH_RB_NUMBER_OF" enabled="true">12</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<DynamicAttributeValue source="SectionIteration" attributeName="LTE_CARRIER" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="LTE_MEAS_UL_POWER_UPPER_DELTA" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="LTE_MEAS_UL_POWER_LOWER_DELTA" />
							<DynamicAttributeValue source="EvmUpperLimit" attributeName="LTE_MEAS_TX_EVM_UPPER_LIMIT" />
							<DynamicAttributeValue source="OrgOffUpperLimit" attributeName="LTE_MEAS_TX_ORIGOFFSET_UPPER_LIMIT" />
							<DynamicAttributeValue source="IbeLeakPwrUpperLimit" attributeName="LTE_MEAS_TX_IBE_CARRLEAK_PWR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="LTE_MEAS_TX_FREQERROR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="LTE_MEAS_TX_FREQERROR_LOWER_LIMIT" />
							<DynamicAttributeValue source="SemOOBUpperLimit" attributeName="LTE_MEAS_OBW_UPPER_LIMIT" />
							<Attributes>
								<Attribute name="LTE_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="LTE_MEAS_TX_EVM_UPPER_LIMIT" enabled="true">17.5</Attribute>
								<Attribute name="LTE_MEAS_TX_ORIGOFFSET_UPPER_LIMIT" enabled="true">-24.2</Attribute>
								<Attribute name="LTE_MEAS_TX_IBE_CARRLEAK_PWR_UPPER_LIMIT" enabled="true">-24.2</Attribute>
								<Attribute name="LTE_MEAS_TX_FREQERROR_UPPER_LIMIT" enabled="true">0.1</Attribute>
								<Attribute name="LTE_MEAS_TX_FREQERROR_LOWER_LIMIT" enabled="true">-0.1</Attribute>
								<Attribute name="LTE_MEAS_OBW_UPPER_LIMIT" enabled="true">10.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<DynamicAttributeValue source="MeasureUlPower" attributeName="LTE_MEAS_UL_POWER" />
							<DynamicAttributeValue source="MeasureEvm" attributeName="LTE_MEAS_TX_EVM" />
							<DynamicAttributeValue source="MeasureFreqErr" attributeName="LTE_MEAS_TX_FREQERROR" />
							<DynamicAttributeValue source="MeasureSem" attributeName="LTE_MEAS_SEM" />
							<DynamicAttributeValue source="MeasureObw" attributeName="LTE_MEAS_OBW" />
							<DynamicAttributeValue source="MeasureAclr" attributeName="LTE_MEAS_ACLR" />
							<DynamicAttributeValue source="MeasureSpectFlat" attributeName="LTE_MEAS_TX_SPECFLATNESS" />
							<DynamicAttributeValue source="MeasureOrigOffset" attributeName="LTE_MEAS_TX_ORIGOFFSET" />
							<DynamicAttributeValue source="MeasureIbe" attributeName="LTE_MEAS_TX_IBE" />
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="LTE_MEAS_UL_POWER" enabled="true" />
								<Attribute name="LTE_MEAS_TX_FREQERROR" enabled="true" />
								<Attribute name="LTE_MEAS_TX_EVM" enabled="true" />
								<Attribute name="LTE_MEAS_SEM" enabled="true" />
								<Attribute name="LTE_MEAS_OBW" enabled="true" />
								<Attribute name="LTE_MEAS_ACLR" enabled="true" />
								<Attribute name="LTE_MEAS_TX_SPECFLATNESS" enabled="true" />
								<Attribute name="LTE_MEAS_TX_ORIGOFFSET" enabled="true" />
								<Attribute name="LTE_MEAS_TX_IBE" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="LTE_Measure_Rx">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<DynamicAttributeValue source="SectionIteration" attributeName="LTE_CARRIER" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="LTE_DL_POWER" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="LTE_MEAS_RX_LEVEL_LOWER_DELTA" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="LTE_MEAS_RX_LEVEL_UPPER_DELTA" />
							<DynamicAttributeValue source="EstSenUpperLimit" attributeName="LTE_MEAS_EST_SEN_UPPERLIMIT" />
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="LTE_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="LTE_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="LTE_MEAS_EST_SEN_UPPERLIMIT" enabled="true">-93.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_LTE_MEASURE">
							<DynamicAttributeValue source="MeasureRxLevel" attributeName="LTE_MEAS_RX_LEVEL" />
							<DynamicAttributeValue source="MeasureSensitivity" attributeName="LTE_MEAS_EST_SEN" />
							<Attributes>
								<Attribute name="LTE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="LTE_MEAS_RX_LEVEL" enabled="true" />
								<Attribute name="LTE_MEAS_EST_SEN" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_SelfTest">
			<Segments>
				<Segment enabled="true" name="SelfTest Values">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_INIT">
							<DynamicAttributeValue source="SequenceTxSelfTest" attributeName="TX_SELF_TEST_MODE" />
							<DynamicAttributeValue source="SequenceRxSelfTest" attributeName="RX_SELF_TEST_MODE" />
							<Attributes>
								<Attribute name="WCDMA_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="TX_SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="TX_SELF_TEST_MEASUREMENTS" enabled="true">POWER,EVM,ACLR,SEM,OBW,VSWR</Attribute>
								<Attribute name="RX_SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="WCDMA_MEAS_EST_SEN_LOOP_COUNT" enabled="true">3</Attribute>
								<Attribute name="SELF_TEST_MEAS_NUMBER_OF_AVERAGE" enabled="true">1</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_LIMIT" enabled="true">-50.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_EVM_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_ACLR_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_VSWR_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_SEM_LIMIT" enabled="true">20.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_OBW_LIMIT" enabled="true">20.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_Config">
			<Segments>
				<Segment enabled="true" name="SequenceControl">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<DynamicAttributeValue source="SequenceTriggerType" attributeName="BASE_COMMON_TRIGGER_TYPE" />
							<DynamicAttributeValue source="SequenceTxSelfTest" attributeName="SELF_TEST_MODE" />
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">0</Attribute>
								<Attribute name="BASE_COMMON_TECH_TYPE" enabled="true">WCDMA</Attribute>
								<Attribute name="BASE_EQUIP_STARTUP_RESET_INHIBIT" enabled="true">1</Attribute>
								<Attribute name="BASE_MOBILE_MSGS_F3" enabled="true">0</Attribute>
								<Attribute name="BASE_MOBILE_MSGS_L1" enabled="true">0</Attribute>
								<Attribute name="BASE_COMMON_TRIGGER_TYPE" enabled="true">Tx</Attribute>
								<Attribute name="FTM_COMMAND_TIMING_PROFILE" enabled="true">1</Attribute>
								<Attribute name="SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="EST_SEN_HIGHEST_LNA_GAIN" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_Init">
			<Segments>
				<Segment enabled="true" name="Set Initial Radio Configuration">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_INIT">
							<DynamicAttributeValue source="BandNumber" attributeName="WCDMA_BAND" />
							<DynamicAttributeValue source="DlChannel" attributeName="WCDMA_OPT_CHANNEL" />
							<DynamicAttributeValue source="BandRxChains" attributeName="WCDMA_TUNE_NUM_RX_CHAIN" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="WCDMA_FL_POWER" />
							<DynamicAttributeValue source="AntPortIteration" attributeName="WCDMA_ANT_PORT_STATE" />
							<Attributes>
								<Attribute name="WCDMA_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="WCDMA_BAND" enabled="true">1</Attribute>
								<Attribute name="WCDMA_TX_POWER_AFTER_RADIO_TUNE" enabled="true">0</Attribute>
								<Attribute name="WCDMA_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="WCDMA_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_HEADROOM" enabled="true">10</Attribute>
								<Attribute name="WCDMA_RL_POWER_MAX" enabled="true">23</Attribute>
								<Attribute name="WCDMA_FL_POWER" enabled="true">-60.0</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
								<Attribute name="WCDMA_RL_POWER" enabled="true">0.0</Attribute>
								<Attribute name="WCDMA_RX_MEASUREMENT_OFFSET_MS" enabled="true">10</Attribute>
								<Attribute name="WCDMA_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="WCDMA_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="WCDMA_ANT_PORT_STATE" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_Path_Config">
			<Segments>
				<Segment enabled="true" name="WCDMA Set Radio/Path Configuration">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_INIT">
							<DynamicAttributeValue source="UseRecommendedRadioAllocation" attributeName="WCDMA_USE_RECOMMENDED_RADIO_ALLOCATION" />
							<DynamicAttributeValue source="Rx0Device" attributeName="WCDMA_RX0_DEVICE" />
							<DynamicAttributeValue source="Rx0SignalPath" attributeName="WCDMA_RX0_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx0AntPath" attributeName="WCDMA_RX0_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx0PllId" attributeName="WCDMA_RX0_PLL_ID" />
							<DynamicAttributeValue source="Rx1Device" attributeName="WCDMA_RX1_DEVICE" />
							<DynamicAttributeValue source="Rx1SignalPath" attributeName="WCDMA_RX1_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx1AntPath" attributeName="WCDMA_RX1_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx1PllId" attributeName="WCDMA_RX1_PLL_ID" />
							<DynamicAttributeValue source="TxDevice" attributeName="WCDMA_TX_DEVICE" />
							<DynamicAttributeValue source="TxSignalPath" attributeName="WCDMA_TX_SIGNAL_PATH" />
							<DynamicAttributeValue source="TxAntPath" attributeName="WCDMA_TX_ANTENNA_PATH" />
							<DynamicAttributeValue source="TxPllId" attributeName="WCDMA_TX_PLL_ID" />
							<Attributes>
								<Attribute name="WCDMA_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="WCDMA_USE_RECOMMENDED_RADIO_ALLOCATION" enabled="true">1</Attribute>
								<Attribute name="WCDMA_TX_DEVICE" enabled="true">0</Attribute>
								<Attribute name="WCDMA_TX_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="WCDMA_TX_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="WCDMA_TX_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX0_DEVICE" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX0_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX0_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX0_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX1_DEVICE" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX1_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX1_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RX1_PLL_ID" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_Freq_Adjust">
			<Segments>
				<Segment enabled="true" name="========== Mobile: Setup for Freq Offset Calc ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_INIT">
							<Attributes>
								<Attribute name="WCDMA_INIT_MODE" enabled="true">FREQ_OFFSET_SETUP</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Equip: Compute Mobile Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_INIT">
							<Attributes>
								<Attribute name="WCDMA_INIT_MODE" enabled="true">FREQ_OFFSET_COMPUTE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Mobile: Set Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_INIT">
							<Attributes>
								<Attribute name="WCDMA_INIT_MODE" enabled="true">FREQ_OFFSET_SET_MOBILE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish WCDMA FTM RF Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_START">
							<Attributes>
								<Attribute name="WCDMA_RL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="WCDMA_RL_POWER" enabled="true">-25.0</Attribute>
								<Attribute name="WCDMA_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-20.0</Attribute>
								<Attribute name="WCDMA_QUERY_UNIFIED_TX_INFO" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_MEASURE">
							<Attributes>
								<Attribute name="WCDMA_SEGMENT_DURATION_MS" enabled="true">6</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="WCDMA_RL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_ILPC_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish WCDMA Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_START">
							<Attributes>
								<Attribute name="WCDMA_ILPC_TEST_ENABLE" enabled="true">1</Attribute>
								<Attribute name="WCDMA_DURATION_DCH_SETUP_MS" enabled="true">260</Attribute>
								<Attribute name="WCDMA_DURATION_RL_POWER_SET_MIN_MS" enabled="true">10</Attribute>
								<Attribute name="WCDMA_DELAY_RL_POWER_SET_MS" enabled="true">20</Attribute>
								<Attribute name="WCDMA_RMC_TYPE" enabled="true">0</Attribute>
								<Attribute name="WCDMA_FL_POWER" enabled="true">-85.0</Attribute>
								<Attribute name="WCDMA_RL_POWER_MAX" enabled="true">30.0</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_LEVEL" enabled="true">20.0</Attribute>
								<Attribute name="WCDMA_RL_POWER" enabled="true">20.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_UPPER_DELTA" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_ILPC">
			<Segments>
				<Segment enabled="true" name="========== ILPC Test BEGIN ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_MEASURE">
							<Attributes>
								<Attribute name="WCDMA_MEAS_ILPC_1SLOTDELTA_LOWER_LIMIT" enabled="true">0.4</Attribute>
								<Attribute name="WCDMA_MEAS_ILPC_1SLOTDELTA_UPPER_LIMIT" enabled="true">1.6</Attribute>
								<Attribute name="WCDMA_MEAS_UE_ILPC_POWER" enabled="true"/>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_PwrSweep_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish WCDMA Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_START">
							<Attributes>
								<Attribute name="WCDMA_DURATION_RL_POWER_SET_MIN_MS" enabled="true">2</Attribute>
								<Attribute name="WCDMA_DELAY_RL_POWER_SET_MS" enabled="true">20</Attribute>
								<Attribute name="WCDMA_DELAY_PRETRIGGER_MS" enabled="true">50</Attribute>
								<Attribute name="WCDMA_SELECTED_RX_CHAIN_LIST" enabled="true">0</Attribute>
								<Attribute name="WCDMA_RL_POWER_MAX" enabled="true">30.0</Attribute>
								<Attribute name="WCDMA_RL_POWER" enabled="true">-45.0</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_HEADROOM" enabled="true">8.0</Attribute>
								<Attribute name="WCDMA_RL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="WCDMA_RMC_TYPE" enabled="true">0</Attribute>
								<Attribute name="WCDMA_FL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_UPPER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="WCDMA_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="WCDMA_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">2.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="WCDMA_PwrSweep_Test">
			<Segments>
				<Segment enabled="true" name="========== Power Sweep Test BEGIN ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_MEASURE">
							<Attributes>
								<Attribute name="WCDMA_FL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_SWEEP" enabled="true">SSS(20,-48,-1)</Attribute>
								<Attribute name="WCDMA_MEAS_ILPC_1SLOTDELTA_LOWER_LIMIT" enabled="true">0.4</Attribute>
								<Attribute name="WCDMA_MEAS_ILPC_1SLOTDELTA_UPPER_LIMIT" enabled="true">1.6</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_WCDMA_MEASURE">
							<Attributes>
								<Attribute name="WCDMA_FL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER_SWEEP" enabled="true">SSS(-48,20,1)</Attribute>
								<Attribute name="WCDMA_MEAS_ILPC_1SLOTDELTA_LOWER_LIMIT" enabled="true">0.4</Attribute>
								<Attribute name="WCDMA_MEAS_ILPC_1SLOTDELTA_UPPER_LIMIT" enabled="true">1.6</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
