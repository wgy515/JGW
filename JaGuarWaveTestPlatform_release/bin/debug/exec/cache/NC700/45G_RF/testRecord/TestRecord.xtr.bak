							<DynamicAttributeValue source="Rx3PathIndex" attributeName="NR_RX3_PATH_INDEX" />
							<DynamicAttributeValue source="Rx3SignalPath" attributeName="NR_RX3_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx3AntPath" attributeName="NR_RX3_ANTENNA_PATH" />
