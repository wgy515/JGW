								<Attribute name="NR_MEAS_TX_FREQERROR_LOWER_LIMIT" enabled="true">-0.1</Attribute>
								<Attribute name="NR_MEAS_OBW_UPPER_LIMIT" enabled="true">10.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<DynamicAttributeValue source="MeasureUlPower" attributeName="NR_MEAS_UL_POWER" />
							<DynamicAttributeValue source="MeasureEvm" attributeName="NR_MEAS_TX_EVM" />
