							<DynamicAttributeValue source="UlPowerDelta" attributeName="WCDMA_MEAS_UE_POWER_LOWER_DELTA" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="WCDMA_FL_POWER" />
