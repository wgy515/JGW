								<Attribute name="TDSCDMA_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="TDSCDMA_BAND" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_TX_POWER_AFTER_RADIO_TUNE" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="TDSCDMA_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_HEADROOM" enabled="true">10</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_MAX" enabled="true">23</Attribute>
								<Attribute name="TDSCDMA_DL_POWER" enabled="true">-90.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_TS1" enabled="true">0.0</Attribute>
								<Attribute name="TDSCDMA_TPC_STEP" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_RX_MEASUREMENT_OFFSET_MS" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_TX_ACLR_UTRA_OFFSET_NEG2_LOWER_LIMIT" enabled="true">-43.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_TX_ACLR_UTRA_OFFSET_NEG1_LOWER_LIMIT" enabled="true">-33.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_TX_ACLR_UTRA_OFFSET_POS1_LOWER_LIMIT" enabled="true">-33.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_TX_ACLR_UTRA_OFFSET_POS2_LOWER_LIMIT" enabled="true">-43.0</Attribute>
								<Attribute name="TDSCDMA_ANT_PORT_STATE" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_Path_Config">
			<Segments>
				<Segment enabled="true" name="TDSCDMA Set Radio/Path Configuration">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_INIT">
							<DynamicAttributeValue source="UseRecommendedRadioAllocation" attributeName="TDSCDMA_USE_RECOMMENDED_RADIO_ALLOCATION" />
							<DynamicAttributeValue source="Rx0Device" attributeName="TDSCDMA_RX0_DEVICE" />
							<DynamicAttributeValue source="Rx0SignalPath" attributeName="TDSCDMA_RX0_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx0AntPath" attributeName="TDSCDMA_RX0_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx0PllId" attributeName="TDSCDMA_RX0_PLL_ID" />
							<DynamicAttributeValue source="Rx1Device" attributeName="TDSCDMA_RX1_DEVICE" />
							<DynamicAttributeValue source="Rx1SignalPath" attributeName="TDSCDMA_RX1_SIGNAL_PATH" />
							<DynamicAttributeValue source="Rx1AntPath" attributeName="TDSCDMA_RX1_ANTENNA_PATH" />
							<DynamicAttributeValue source="Rx1PllId" attributeName="TDSCDMA_RX1_PLL_ID" />
							<DynamicAttributeValue source="TxDevice" attributeName="TDSCDMA_TX_DEVICE" />
							<DynamicAttributeValue source="TxSignalPath" attributeName="TDSCDMA_TX_SIGNAL_PATH" />
							<DynamicAttributeValue source="TxAntPath" attributeName="TDSCDMA_TX_ANTENNA_PATH" />
							<DynamicAttributeValue source="TxPllId" attributeName="TDSCDMA_TX_PLL_ID" />
							<Attributes>
								<Attribute name="TDSCDMA_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="TDSCDMA_USE_RECOMMENDED_RADIO_ALLOCATION" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_TX_DEVICE" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_TX_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_TX_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_TX_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX0_DEVICE" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX0_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX0_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX0_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX1_DEVICE" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX1_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX1_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="TDSCDMA_RX1_PLL_ID" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_Freq_Adjust">
			<Segments>
				<Segment enabled="true" name="========== Mobile: Setup for Freq Offset Calc ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_INIT">
							<Attributes>
								<Attribute name="TDSCDMA_INIT_MODE" enabled="true">FREQ_OFFSET_SETUP</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Equip: Compute Mobile Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_INIT">
							<Attributes>
								<Attribute name="TDSCDMA_INIT_MODE" enabled="true">FREQ_OFFSET_COMPUTE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Mobile: Set Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_INIT">
							<Attributes>
								<Attribute name="TDSCDMA_INIT_MODE" enabled="true">FREQ_OFFSET_SET_MOBILE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish TDSCDMA FTM RF Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_START">
							<Attributes>
								<Attribute name="TDSCDMA_NUM_UL_SLOTS" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_TS1" enabled="true">-25.0</Attribute>
								<Attribute name="TDSCDMA_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-20.0</Attribute>
								<Attribute name="TDSCDMA_QUERY_UNIFIED_TX_INFO" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_MEASURE">
							<Attributes>
								<Attribute name="TDSCDMA_SEGMENT_DURATION_MS" enabled="true">16</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_TS1" enabled="true">24.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_CLPC_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish TDSCDMA Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_START">
							<Attributes>
								<Attribute enabled="true" name="TDSCDMA_CLPC_TEST_ENABLE">1</Attribute>
								<Attribute enabled="true" name="TDSCDMA_RMC_TYPE">0</Attribute>
								<Attribute enabled="true" name="TDSCDMA_MODULATION_TYPE">QPSK</Attribute>
								<Attribute enabled="true" name="TDSCDMA_UL_SLOT">1</Attribute>
								<Attribute enabled="true" name="TDSCDMA_DL_SLOT">4</Attribute>
								<Attribute enabled="true" name="TDSCDMA_MAX_UL_POWER">30</Attribute>
								<Attribute enabled="true" name="TDSCDMA_TPC_STEP">1</Attribute>
								<Attribute enabled="true" name="TDSCDMA_DL_POWER">-85.0</Attribute>
								<Attribute enabled="true" name="TDSCDMA_UL_POWER">20.0</Attribute>
								<Attribute enabled="true" name="TDSCDMA_UL_POWER_REF_HEADROOM">12.0</Attribute>
								<Attribute enabled="true" name="TDSCDMA_UL_POWER_REF_LEVEL">20.0</Attribute>
								<Attribute enabled="true" name="TDSCDMA_RF_ANALYZER_TRIGGER_THRESHOLD">-35.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_CLPC">
			<Segments>
				<Segment enabled="true" name="========== CLPC Test BEGIN ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_MEASURE">
							<Attributes>
								<Attribute name="TDSCDMA_MEAS_CLPC_1SLOTDELTA_LOWER_LIMIT" enabled="true">0.5</Attribute>
								<Attribute name="TDSCDMA_MEAS_CLPC_1SLOTDELTA_UPPER_LIMIT" enabled="true">1.5</Attribute>
								<Attribute name="TDSCDMA_MEAS_UE_CLPC_POWER" enabled="true"/>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_Stop">
			<Segments>
				<Segment enabled="true" name="=== Mobile-CallRelease, EQUIP-RfGenOff ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_STOP">
							<Attributes>
								<Attribute name="TDSCDMA_ACTION_CALL_RELEASE" enabled="true" />
								<Attribute name="TDSCDMA_ACTION_RF_GEN_OFF" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_PreAbstract">
			<Segments>
				<Segment enabled="true" name="Setting power levels before beginning handover">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_MEASURE">
							<Attributes>
								<Attribute name="TDSCDMA_SEGMENT_DURATION_MS" enabled="true">10</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_TS1" enabled="true">-46.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_LEVEL" enabled="true">-46.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_PostAbstract">
			<Segments>
				<Segment enabled="true" name="Setting power levels after running test">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_MEASURE">
							<Attributes>
								<Attribute name="TDSCDMA_SEGMENT_DURATION_MS" enabled="false">2</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_TS1" enabled="false">0.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_LEVEL" enabled="false">0.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_Handover">
			<Segments>
				<Segment enabled="true" name="Handover Section">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_MEASURE">
							<DynamicAttributeValue source="BandNumber" attributeName="TDSCDMA_BAND" />
							<DynamicAttributeValue source="DlChannel" attributeName="TDSCDMA_OPT_CHANNEL" />
							<DynamicAttributeValue source="BandRxChains" attributeName="TDSCDMA_TUNE_NUM_RX_CHAIN" />
							<Attributes>
								<Attribute name="TDSCDMA_SEGMENT_DURATION_MS" enabled="true">60</Attribute>
								<Attribute name="TDSCDMA_BAND" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_TX_POWER_AFTER_RADIO_TUNE" enabled="true">1</Attribute>
								<Attribute name="TDSCDMA_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="TDSCDMA_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_Measure">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_TDSCDMA_MEASURE">
							<DynamicAttributeValue source="UlPowerLevel" attributeName="TDSCDMA_UL_POWER_TS1" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="TDSCDMA_UL_POWER_REF_LEVEL" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="TDSCDMA_MEAS_UL_POWER_UPPER_DELTA" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="TDSCDMA_MEAS_UL_POWER_LOWER_DELTA" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="TDSCDMA_DL_POWER" />
							<DynamicAttributeValue source="DlBerSensLevel" whenTestMode="NSVFS" attributeName="TDSCDMA_DL_POWER" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="TDSCDMA_MEAS_RX_LEVEL_LOWER_DELTA" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="TDSCDMA_MEAS_RX_LEVEL_UPPER_DELTA" />
							<DynamicAttributeValue source="SemOOBUpperLimit" attributeName="TDSCDMA_MEAS_OBW_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="TDSCDMA_MEAS_TX_FREQERROR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="TDSCDMA_MEAS_TX_FREQERROR_LOWER_LIMIT" />
							<Attributes>
								<Attribute name="TDSCDMA_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_TS1" enabled="true">24.0</Attribute>
								<Attribute name="TDSCDMA_UL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_UL_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="TDSCDMA_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="TDSCDMA_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="TDSCDMA_MEAS_OBW_UPPER_LIMIT" enabled="true">1.6</Attribute>
