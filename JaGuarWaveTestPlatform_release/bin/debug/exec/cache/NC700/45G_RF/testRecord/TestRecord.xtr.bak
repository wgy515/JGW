				<Segment enabled="true" name="========== Equip: Compute Mobile Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_INIT">
							<Attributes>
								<Attribute name="EDGE_INIT_MODE" enabled="true">FREQ_OFFSET_COMPUTE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Mobile: Set Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_INIT">
							<Attributes>
								<Attribute name="EDGE_INIT_MODE" enabled="true">FREQ_OFFSET_SET_MOBILE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish EDGE FTM RF Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_START">
							<Attributes>
								<Attribute name="EDGE_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-15</Attribute>
								<Attribute name="EDGE_MEAS_EST_SEN_LOOP_COUNT" enabled="true">1</Attribute>
								<Attribute name="EDGE_QUERY_UNIFIED_TX_INFO" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">32</Attribute>
								<Attribute name="EDGE_PCL" enabled="true">5</Attribute>
								<Attribute name="EDGE_POWER_LEVEL" enabled="true">33.0</Attribute>
								<Attribute name="EDGE_RL_POWER_REF_LEVEL" enabled="true">33.0</Attribute>
								<Attribute name="EDGE_FL_POWER" enabled="true">-85.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_Start_RxTrigger">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish EDGE FTM RF Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_START">
							<Attributes>
								<Attribute name="EDGE_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-15</Attribute>
								<Attribute name="EDGE_MEAS_EST_SEN_LOOP_COUNT" enabled="true">1</Attribute>
								<Attribute name="NUMBER_OF_AVERAGES" enabled="true">1</Attribute>
								<Attribute name="EDGE_FL_POWER" enabled="true">-95</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Dummy Segment for Synchronization ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">240</Attribute>
								<Attribute name="EDGE_FL_POWER" enabled="true">-95</Attribute>
								<Attribute name="EDGE_DUMMY_SEGMENT" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">32</Attribute>
								<Attribute name="EDGE_FL_POWER" enabled="true">-45.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_NSVFS_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish EDGE FTM RF Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_START">
							<DynamicAttributeValue source="Pcl" attributeName="EDGE_PCL" />
							<DynamicAttributeValue source="Pcl" attributeName="EDGE_PCL_SETUP" />
							<Attributes>
								<Attribute enabled="true" name="EDGE_PCL_SETUP">19</Attribute>
								<Attribute enabled="true" name="EDGE_PCL">5</Attribute>
								<Attribute enabled="true" name="EDGE_DL_SLOT_FIRST_ACTIVE">1</Attribute>
								<Attribute enabled="true" name="EDGE_DL_SLOT_FIRST_NUM">2</Attribute>
								<Attribute enabled="true" name="EDGE_DL_SLOT_SECOND_ACTIVE">1</Attribute>
								<Attribute enabled="true" name="EDGE_DL_SLOT_SECOND_NUM">3</Attribute>
								<Attribute enabled="true" name="EDGE_UL_SLOT_FIRST_ACTIVE">1</Attribute>
								<Attribute enabled="true" name="EDGE_UL_SLOT_FIRST_NUM">2</Attribute>
								<Attribute enabled="true" name="EDGE_UL_SLOT_SECOND_ACTIVE">0</Attribute>
								<Attribute enabled="true" name="EDGE_UL_SLOT_SECOND_NUM">0</Attribute>
								<Attribute enabled="true" name="EDGE_RF_ANALYZER_TRIGGER_THRESHOLD">-15</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<Attributes>
								<Attribute enabled="true" name="EDGE_SEGMENT_DURATION_MS">120</Attribute>
								<Attribute enabled="true" name="EDGE_SRB_LOOPBACK_FORCE" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_Stop">
			<Segments>
				<Segment enabled="true" name="=== Mobile-CallRelease, EQUIP-RfGenOff ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_STOP">
							<Attributes>
								<Attribute name="EDGE_ACTION_CALL_RELEASE" enabled="true" />
								<Attribute name="EDGE_ACTION_RF_GEN_OFF" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_Handover">
			<Segments>
				<Segment enabled="true" name="Handover Section">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<DynamicAttributeValue source="BandNumber" attributeName="EDGE_BAND" />
							<DynamicAttributeValue source="DlChannel" attributeName="EDGE_OPT_CHANNEL" />
							<DynamicAttributeValue source="DlChannel" attributeName="EDGE_OPT_CHANNEL_BCCH" />
							<DynamicAttributeValue source="BandRxChains" attributeName="EDGE_TUNE_NUM_RX_CHAIN" />
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">240</Attribute>
								<Attribute name="EDGE_BAND" enabled="true">850</Attribute>
								<Attribute name="EDGE_TX_POWER_AFTER_RADIO_TUNE" enabled="true">0</Attribute>
								<Attribute name="EDGE_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="EDGE_OPT_CHANNEL_BCCH" enabled="true">LOW</Attribute>
								<Attribute name="EDGE_TUNE_NUM_RX_CHAIN" enabled="true">0</Attribute>
								<Attribute name="RX_FUNCTION_TYPE" enabled="true">GET_RSSI</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_NSVFS_Handover">
			<Segments>
				<Segment enabled="true" name="Handover Section">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<DynamicAttributeValue source="BandNumber" attributeName="EDGE_BAND" />
							<DynamicAttributeValue source="DlChannel" attributeName="EDGE_OPT_CHANNEL" />
							<DynamicAttributeValue source="DlChannel" attributeName="EDGE_OPT_CHANNEL_BCCH" />
							<DynamicAttributeValue source="BandRxChains" attributeName="EDGE_TUNE_NUM_RX_CHAIN" />
							<Attributes>
								<Attribute enabled="true" name="EDGE_SEGMENT_DURATION_MS">120</Attribute>
								<Attribute enabled="true" name="EDGE_BAND">850</Attribute>
								<Attribute enabled="true" name="EDGE_SRB_LOOPBACK_INHIBIT"></Attribute>
								<Attribute enabled="true" name="EDGE_TX_POWER_AFTER_RADIO_TUNE">0</Attribute>
								<Attribute enabled="true" name="EDGE_OPT_CHANNEL">LOW</Attribute>
								<Attribute enabled="true" name="EDGE_OPT_CHANNEL_BCCH">LOW</Attribute>
								<Attribute enabled="true" name="EDGE_TUNE_NUM_RX_CHAIN">0</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<Attributes>
								<Attribute enabled="true" name="EDGE_SEGMENT_DURATION_MS">120</Attribute>
								<Attribute enabled="true" name="EDGE_SRB_LOOPBACK_FORCE" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_Measure">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<DynamicAttributeValue source="Pcl" attributeName="EDGE_PCL" />
							<DynamicAttributeValue source="Modulation" attributeName="EDGE_MODULATION_SCHEME" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="EDGE_POWER_LEVEL" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="EDGE_RL_POWER_REF_LEVEL" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="EDGE_MEAS_POWER_LOWER_DELTA" />
							<DynamicAttributeValue source="UlPowerDelta" attributeName="EDGE_MEAS_POWER_UPPER_DELTA" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="EDGE_FL_POWER" />
							<DynamicAttributeValue source="DlBerSensLevel" whenTestMode="NSVFS" attributeName="EDGE_FL_POWER" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="EDGE_MEAS_RX_LEVEL_LOWER_DELTA" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="EDGE_MEAS_RX_LEVEL_UPPER_DELTA" />
							<DynamicAttributeValue source="EvmUpperLimit" attributeName="EDGE_MEAS_EVM_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="EDGE_MEAS_FREQ_ERROR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="EDGE_MEAS_FREQ_ERROR_LOWER_LIMIT" />
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="EDGE_MODULATION_SCHEME" enabled="true">MCS1</Attribute>
								<Attribute name="EDGE_PCL" enabled="true">15</Attribute>
								<Attribute name="EDGE_POWER_LEVEL" enabled="true">0.0</Attribute>
								<Attribute name="EDGE_RL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
								<Attribute name="EDGE_MEAS_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="EDGE_MEAS_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="EDGE_FL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="EDGE_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="EDGE_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="EDGE_MEAS_EVM_UPPER_LIMIT" enabled="true">100.0</Attribute>
								<Attribute name="EDGE_MEAS_FREQ_ERROR_UPPER_LIMIT" enabled="true">0.1</Attribute>
								<Attribute name="EDGE_MEAS_FREQ_ERROR_LOWER_LIMIT" enabled="true">-0.1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<DynamicAttributeValue source="MeasureUlPower" attributeName="EDGE_MEAS_BURST_TIMING" />
							<DynamicAttributeValue source="MeasureMod" attributeName="EDGE_MEAS_MOD" />
							<DynamicAttributeValue source="MeasureOrfs" attributeName="EDGE_MEAS_ORFS_SWITCHING" />
							<DynamicAttributeValue source="MeasureOrfs" attributeName="EDGE_MEAS_ORFS_MODULATION" />
							<DynamicAttributeValue source="MeasureRxLevel" attributeName="EDGE_MEAS_RX_LEVEL" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="RFVFS" attributeName="EDGE_MEAS_EST_SEN" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="NSVFS" attributeName="EDGE_ACTION_SE_BER_LOGGING_BEGIN" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="NSVFS" attributeName="EDGE_MEAS_SE_BER" />
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="EDGE_MEAS_BURST_TIMING" enabled="true" />
								<Attribute name="EDGE_MEAS_MOD" enabled="true" />
								<Attribute name="EDGE_MEAS_ORFS_SWITCHING" enabled="true" />
								<Attribute name="EDGE_MEAS_ORFS_MODULATION" enabled="true" />
								<Attribute name="EDGE_MEAS_RX_LEVEL" enabled="true" />
								<Attribute name="EDGE_MEAS_EST_SEN" enabled="true" />
								<Attribute name="EDGE_ACTION_SE_BER_LOGGING_BEGIN" enabled="true" />
								<Attribute name="EDGE_MEAS_SE_BER" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="EDGE_Measure_Rx">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<DynamicAttributeValue source="DlPowerLevel" attributeName="EDGE_FL_POWER" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="EDGE_MEAS_RX_LEVEL_LOWER_DELTA" />
							<DynamicAttributeValue source="RxLevelDelta" attributeName="EDGE_MEAS_RX_LEVEL_UPPER_DELTA" />
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="EDGE_FL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="EDGE_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="EDGE_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_MEASURE">
							<DynamicAttributeValue source="MeasureRxLevel" attributeName="EDGE_MEAS_RX_LEVEL" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="RFVFS" attributeName="EDGE_MEAS_EST_SEN" />
							<Attributes>
								<Attribute name="EDGE_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="EDGE_MEAS_RX_LEVEL" enabled="true" />
								<Attribute name="EDGE_MEAS_EST_SEN" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Config">
			<Segments>
				<Segment enabled="true" name="SequenceControl">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_COMMON_SEQUENCE_CONTROL">
							<DynamicAttributeValue source="SequenceTxSelfTest" attributeName="SELF_TEST_MODE" />
							<DynamicAttributeValue source="SequenceTriggerType" attributeName="BASE_COMMON_TRIGGER_TYPE" />
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">0</Attribute>
								<Attribute name="BASE_EQUIP_STARTUP_RESET_INHIBIT" enabled="true">1</Attribute>
								<Attribute name="BASE_MOBILE_MSGS_F3" enabled="true">0</Attribute>
								<Attribute name="BASE_MOBILE_MSGS_L1" enabled="true">0</Attribute>
								<Attribute name="FTM_COMMAND_TIMING_PROFILE" enabled="true">1</Attribute>
								<Attribute name="SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="BASE_COMMON_TRIGGER_TYPE" enabled="true">Tx</Attribute>
								<Attribute name="BASE_COMMON_RX_TRIGGER_THRESHOLD" enabled="true">-65.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_SelfTest">
			<Segments>
				<Segment enabled="true" name="SUB6 SelfTest Values">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT">
							<DynamicAttributeValue source="SequenceTxSelfTest" attributeName="TX_SELF_TEST_MODE" />
							<DynamicAttributeValue source="SequenceRxSelfTest" attributeName="RX_SELF_TEST_MODE" />
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="TX_SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="TX_SELF_TEST_MEASUREMENTS" enabled="true">POWER,EVM,ACLR,SPECTRAL_FLATNESS,SEM,OBW,VSWR</Attribute>
								<Attribute name="RX_SELF_TEST_MODE" enabled="true">OFF</Attribute>
								<Attribute name="NR_MEAS_EST_SEN_MEAS_COUNT" enabled="true">3</Attribute>
								<Attribute name="SELF_TEST_MEAS_NUMBER_OF_AVERAGE" enabled="true">1</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_LIMIT" enabled="true">-40.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_EVM_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_ACLR_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_VSWR_LIMIT" enabled="true">-30.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_SPECFLAT_LIMIT" enabled="true">0.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_SEM_LIMIT" enabled="true">20.0</Attribute>
								<Attribute name="SELF_TEST_MEAS_Tx_POWER_OBW_LIMIT" enabled="true">20.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Init">
			<Segments>
				<Segment enabled="true" name="Set Initial Radio Configuration">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT">
							<DynamicAttributeValue source="dlCarriers" attributeName="NR_NUM_DL_CARRIERS" />
							<DynamicAttributeValue source="ulCarriers" attributeName="NR_NUM_UL_CARRIERS" />
							<DynamicAttributeValue source="NetSigValue" attributeName="NR_NS_VALUE" />
							<DynamicAttributeValue source="AntPortIteration" attributeName="NR_ANT_PORT_STATE" />
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="NR_NUM_DL_CARRIERS" enabled="true">1</Attribute>
								<Attribute name="NR_NUM_UL_CARRIERS" enabled="true">1</Attribute>
								<Attribute name="NR_UL_POWER_REF_HEADROOM" enabled="true">15</Attribute>
								<Attribute name="NR_NS_VALUE" enabled="true">1</Attribute>
								<Attribute name="NR_UL_POWER_MAX" enabled="true">23</Attribute>
								<Attribute name="NR_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="NR_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">2.0</Attribute>
								<Attribute name="NR_SELECTED_RX_CHAIN_LIST" enabled="true">0</Attribute>
								<Attribute name="NR_UL_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="NR_RX_MEASUREMENT_OFFSET_MS" enabled="true">5</Attribute>
								<Attribute name="NR_ANT_PORT_STATE" enabled="true">0</Attribute>
								<Attribute name="NR_APPLY_POINTA_CHANNEL" enabled="true">0</Attribute>
								<Attribute name="NR_TX_DUTY_CYCLE" enabled="true">100</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT" repeatForEach="dlCarriers">
							<DynamicAttributeValue source="AlgorithmIteration" attributeName="NR_CARRIER" />
							<DynamicAttributeValue source="BandNumber" attributeName="NR_BAND" />
							<DynamicAttributeValue source="BandSubBand" attributeName="NR_SUB_BAND_ID" />
							<DynamicAttributeValue source="SubBandUlRange" attributeName="NR_SUB_BAND_UL_CHANNEL_RANGE" />
							<DynamicAttributeValue source="DlChannel" attributeName="NR_OPT_CHANNEL" />
							<DynamicAttributeValue source="ChBandwidth" attributeName="NR_CH_BANDWIDTH" />
							<DynamicAttributeValue source="SubCarrierSpacing" attributeName="NR_SUB_CARRIER_SPACING" />
							<DynamicAttributeValue source="Modulation" attributeName="NR_UL_MODULATION_TYPE" />
							<DynamicAttributeValue source="BandRxChains" attributeName="NR_TUNE_NUM_RX_CHAIN" />
							<DynamicAttributeValue source="IsUplinkActive" attributeName="NR_UPLINK_ACTIVE" />
							<DynamicAttributeValue source="IsContCarrier" attributeName="NR_INTRA_CONT" />
							<DynamicAttributeValue source="IntraAssocCarrier" attributeName="NR_INTRA_ASSOC_CARRIER" />
							<DynamicAttributeValue source="OfdmType" attributeName="NR_OFDM_TYPE" />
							<DynamicAttributeValue source="UlRBAllocation" attributeName="NR_RB_ALLOCATION" />
							<DynamicAttributeValue source="BandPowerClass" attributeName="NR_UL_POWER_CLASS_OVERRIDE" />
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="NR_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="NR_BAND" enabled="true">1</Attribute>
								<Attribute name="NR_SUB_BAND_ID" enabled="true">FULL</Attribute>
								<Attribute name="NR_SUB_BAND_UL_CHANNEL_RANGE" enabled="true"></Attribute>
								<Attribute name="NR_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="NR_CH_BANDWIDTH" enabled="true">20</Attribute>
								<Attribute name="NR_SUB_CARRIER_SPACING" enabled="true">30</Attribute>
								<Attribute name="NR_UL_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="NR_RB_ALLOCATION" enabled="true">OUTER_FULL</Attribute>
								<Attribute name="NR_OFDM_TYPE" enabled="true">CP</Attribute>
								<Attribute name="NR_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
								<Attribute name="NR_UL_POWER" enabled="true">20.0</Attribute>
								<Attribute name="NR_UL_POWER_REF_LEVEL" enabled="true">20.0</Attribute>
								<Attribute name="NR_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="NR_UPLINK_ACTIVE" enabled="true">true</Attribute>
								<Attribute name="NR_INTRA_CONT" enabled="true">false</Attribute>
								<Attribute name="NR_INTRA_ASSOC_CARRIER" enabled="true" />
								<Attribute name="NR_UL_POWER_CLASS_OVERRIDE" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Path_Config">
