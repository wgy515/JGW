			<Segments>
				<Segment enabled="true" name="========== Mobile: Setup for Freq Offset Calc ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_EDGE_INIT">
