							<DynamicAttributeValue source="FreErrDelta" attributeName="CDMA_MEAS_FREQ_ERROR_UPPER_LIMIT" />
							<DynamicAttributeValue source="FreErrDelta" attributeName="CDMA_MEAS_FREQ_ERROR_LOWER_LIMIT" />
							<DynamicAttributeValue source="RHOLowerLimit" attributeName="CDMA_MEAS_RHO_LOWER_LIMIT" />
							<DynamicAttributeValue source="EstSenUpperLimit" attributeName="CDMA_MEAS_EST_SEN_UPPERLIMIT" />
							<Attributes>
								<Attribute name="CDMA_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="CDMA_RL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="CDMA_RL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="CDMA_MEAS_RL_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="CDMA_MEAS_RL_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="CDMA_FL_POWER" enabled="true">-60.0</Attribute>
								<Attribute name="CDMA_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="CDMA_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="CDMA_MEAS_EVM_UPPER_LIMIT" enabled="true">30.0</Attribute>
								<Attribute name="CDMA_MEAS_FREQ_ERROR_UPPER_LIMIT" enabled="true">300</Attribute>
								<Attribute name="CDMA_MEAS_FREQ_ERROR_LOWER_LIMIT" enabled="true">-300</Attribute>
								<Attribute name="CDMA_MEAS_RHO_LOWER_LIMIT" enabled="true">0.9703</Attribute>
								<Attribute name="CDMA_MEAS_EST_SEN_UPPERLIMIT" enabled="true">-105.0</Attribute>
								<Attribute name="CDMA_MEAS_EST_SEN_CTON_LOWERLIMIT" enabled="true">7.3</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="Measure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_CDMA_MEASURE">
							<DynamicAttributeValue source="MeasureUlPower" attributeName="CDMA_MEAS_RL_POWER" />
							<DynamicAttributeValue source="MeasureEvm" attributeName="CDMA_MEAS_EVM" />
							<DynamicAttributeValue source="MeasureEvm" attributeName="CDMA_MEAS_RHO" />
							<DynamicAttributeValue source="MeasureFreqErr" attributeName="CDMA_MEAS_FREQ_ERROR" />
							<DynamicAttributeValue source="MeasureFreqErr" attributeName="CDMA_MEAS_PHASE_ERROR" />
							<DynamicAttributeValue source="MeasureFreqErr" attributeName="CDMA_MEAS_MAG_ERROR" />
							<DynamicAttributeValue source="MeasureMod" attributeName="CDMA_MEAS_MOD" />
							<DynamicAttributeValue source="MeasureAclr" attributeName="CDMA_MEAS_ACPR" />
							<DynamicAttributeValue source="MeasureRxLevel" attributeName="CDMA_MEAS_RX_LEVEL" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="RFVFS" attributeName="CDMA_MEAS_EST_SEN" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="NSVFS" attributeName="CDMA_ACTION_FCH_STATUS_RESET" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="NSVFS" attributeName="CDMA_MEAS_SER" />
							<Attributes>
								<Attribute name="CDMA_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="CDMA_MEAS_RL_POWER" enabled="true" />
								<Attribute name="CDMA_MEAS_RHO" enabled="true" />
								<Attribute name="CDMA_MEAS_FREQ_ERROR" enabled="true" />
								<Attribute name="CDMA_MEAS_PHASE_ERROR" enabled="true" />
								<Attribute name="CDMA_MEAS_MAG_ERROR" enabled="true" />
								<Attribute name="CDMA_MEAS_EVM" enabled="true" />
								<Attribute name="CDMA_MEAS_MOD" enabled="true" />
								<Attribute name="CDMA_MEAS_ACPR" enabled="true" />
								<Attribute name="CDMA_MEAS_RX_LEVEL" enabled="true" />
								<Attribute name="CDMA_MEAS_EST_SEN" enabled="true" />
								<Attribute name="CDMA_ACTION_FCH_STATUS_RESET" enabled="true" />
								<Attribute name="CDMA_MEAS_SER" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="TDSCDMA_SelfTest">
			<Segments>
