								<Attribute name="NR_RX0_SIGNAL_PATH" enabled="true">0</Attribute>
								<Attribute name="NR_RX0_ANTENNA_PATH" enabled="true">0</Attribute>
								<Attribute name="NR_RX0_PLL_ID" enabled="true">0</Attribute>
								<Attribute name="NR_RX0_ANTENNA_NUMBER" enabled="true">0</Attribute>
