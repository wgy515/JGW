							<DynamicAttributeValue source="MeasureRxLevel" attributeName="WCDMA_MEAS_RX_LEVEL" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="RFVFS" attributeName="WCDMA_MEAS_EST_SEN" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="NSVFS" attributeName="WCDMA_ACTION_BER_STATUS_RESET" />
							<DynamicAttributeValue source="MeasureSensitivity" whenTestMode="NSVFS" attributeName="WCDMA_MEAS_SE_BER" />
							<Attributes>
								<Attribute name="WCDMA_SEGMENT_DURATION_MS" enabled="true">100</Attribute>
								<Attribute name="WCDMA_MEAS_UE_POWER" enabled="true" />
								<Attribute name="WCDMA_MEAS_EVM" enabled="true" />
								<Attribute name="WCDMA_MEAS_MOD" enabled="true" />
								<Attribute name="WCDMA_MEAS_SEM" enabled="true" />
								<Attribute name="WCDMA_MEAS_OBW" enabled="true" />
								<Attribute name="WCDMA_MEAS_ACLR" enabled="true" />
								<Attribute name="WCDMA_MEAS_RX_LEVEL" enabled="true" />
								<Attribute name="WCDMA_MEAS_EST_SEN" enabled="true" />
								<Attribute name="WCDMA_ACTION_BER_STATUS_RESET" enabled="true" />
								<Attribute name="WCDMA_MEAS_SE_BER" enabled="true" />
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
