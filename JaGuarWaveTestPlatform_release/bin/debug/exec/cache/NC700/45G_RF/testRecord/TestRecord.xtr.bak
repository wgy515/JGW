								<Attribute name="CDMA_RL_POWER_REF_LEVEL" enabled="true">24.0</Attribute>
								<Attribute name="CDMA_RL_POWER" enabled="true">24.0</Attribute>
								<Attribute name="CDMA_MEAS_RL_POWER_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="CDMA_MEAS_RL_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
