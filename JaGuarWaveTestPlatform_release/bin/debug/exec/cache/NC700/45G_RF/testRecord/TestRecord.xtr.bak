				<Segment enabled="true" name="=== Establish CDMA FTM RF Call ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_CDMA_START">
							<Attributes>
								<Attribute name="CDMA_RL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="CDMA_RL_POWER" enabled="true">-25.0</Attribute>
								<Attribute name="CDMA_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-30.0</Attribute>
