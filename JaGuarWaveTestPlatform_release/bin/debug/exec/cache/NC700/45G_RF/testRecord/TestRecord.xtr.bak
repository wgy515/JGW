								<Attribute name="NR_UL_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="NR_UL_RB_START" enabled="true">0</Attribute>
								<Attribute name="NR_UL_RB_NUMBER_OF" enabled="true">51</Attribute>
								<Attribute name="NR_RB_ALLOCATION" enabled="true">MANUAL</Attribute>
								<Attribute name="NR_OFDM_TYPE" enabled="true">CP</Attribute>
								<Attribute name="NR_NS_VALUE" enabled="true">1</Attribute>
								<Attribute name="NR_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="NR_MEAS_UL_POWER_UPPER_DELTA" enabled="true">3</Attribute>
								<Attribute name="NR_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3</Attribute>
								<Attribute name="NR_MEAS_RX_LEVEL_LOWER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="NR_MEAS_RX_LEVEL_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="NR_MEAS_EST_SEN_UPPERLIMIT" enabled="true">-93.0</Attribute>
								<Attribute name="NR_MEAS_TX_EVM_UPPER_LIMIT" enabled="true">17.5</Attribute>
								<Attribute name="NR_MEAS_TX_ORIGOFFSET_UPPER_LIMIT" enabled="true">-24.2</Attribute>
