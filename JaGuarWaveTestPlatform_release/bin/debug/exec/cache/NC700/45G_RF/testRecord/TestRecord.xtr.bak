		<SegmentGroup ID="SUB6_Freq_Adjust">
			<Segments>
				<Segment enabled="true" name="========== Mobile: Setup for Freq Offset Calc ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT">
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">FREQ_OFFSET_SETUP</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Equip: Compute Mobile Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT">
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">FREQ_OFFSET_COMPUTE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="========== Mobile: Set Freq Offset ==========">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT">
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">FREQ_OFFSET_SET_MOBILE</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Start">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish SUB6 FTM RF Call (Start call from PCC) ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_START">
							<Attributes>
								<Attribute name="NR_SEGMENT_OFFSET_SEGMENT_ID" enabled="true">0</Attribute>
								<Attribute name="NR_SEGMENT_OFFSET_MS" enabled="true">20</Attribute>
								<Attribute name="NR_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="NR_UL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="NR_UL_POWER" enabled="true">-25.0</Attribute>
								<Attribute name="NR_RF_ANALYZER_TRIGGER_THRESHOLD" enabled="true">-20.0</Attribute>
								<Attribute name="NR_FORCE_LEGACY_FREQ_ADJUST" enabled="true">0</Attribute>
								<Attribute name="NR_RX_FREQ_ERR_CW_OFFSET_KHZ" enabled="true">50</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<Attributes>
								<Attribute name="NR_SEGMENT_DURATION_MS" enabled="true">50</Attribute>
								<Attribute name="NR_UL_POWER" enabled="true">28.0</Attribute>
								<Attribute name="NR_UL_POWER_REF_LEVEL" enabled="true">28.0</Attribute>
								<Attribute name="NR_MEAS_UL_POWER_UPPER_DELTA" enabled="true">3.0</Attribute>
								<Attribute name="NR_MEAS_UL_POWER_LOWER_DELTA" enabled="true">3.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Start_RxTrigger">
			<Segments>
				<Segment enabled="true" name="===== Sequence Control - Enable Mobile Batch Mode =====">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_COMMON_SEQUENCE_CONTROL">
							<Attributes>
								<Attribute name="ACTIVATE_SEQUENCE_MODE" enabled="true">1</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Establish SUB6 FTM RF Call (Start call from PCC) ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_START">
							<Attributes>
								<Attribute name="NR_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="NR_UL_POWER_REF_LEVEL" enabled="true">-25.0</Attribute>
								<Attribute name="NR_UL_POWER" enabled="true">-25.0</Attribute>
								<Attribute name="NR_RX_FREQ_ERR_CW_OFFSET_KHZ" enabled="true">50</Attribute>
								<Attribute name="NR_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="NR_DL_CW_OFFSET" enabled="true">2000</Attribute>
								<Attribute name="NR_RF_GEN_ENABLE_WAVEFORM" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Dummy Segment for Synchronization ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<Attributes>
								<Attribute name="NR_SEGMENT_DURATION_MS" enabled="true">150</Attribute>
								<Attribute name="NR_DUMMY_SEGMENT" enabled="true">1</Attribute>
								<Attribute name="NR_DL_POWER" enabled="true">-120.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
				<Segment enabled="true" name="=== Trigger ===">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<Attributes>
								<Attribute name="NR_SEGMENT_DURATION_MS" enabled="true">20</Attribute>
								<Attribute name="NR_DL_POWER" enabled="true">-60.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_PreAbstract">
			<Segments>
				<Segment enabled="true" name="Setting power levels before beginning handover">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<Attributes>
								<Attribute name="NR_SEGMENT_DURATION_MS" enabled="true">50</Attribute>
								<Attribute name="NR_UL_POWER" enabled="true">0.0</Attribute>
								<Attribute name="NR_UL_POWER_REF_LEVEL" enabled="true">0.0</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Handover">
			<Segments>
				<Segment enabled="true" name="Handover Section">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_INIT" repeatForEach="dlCarriers">
							<DynamicAttributeValue source="AlgorithmIteration" attributeName="NR_CARRIER" />
							<DynamicAttributeValue source="BandNumber" attributeName="NR_BAND" />
							<DynamicAttributeValue source="BandSubBand" attributeName="NR_SUB_BAND_ID" />
							<DynamicAttributeValue source="SubBandUlRange" attributeName="NR_SUB_BAND_UL_CHANNEL_RANGE" />
							<DynamicAttributeValue source="DlChannel" attributeName="NR_OPT_CHANNEL" />
							<DynamicAttributeValue source="ChBandwidth" attributeName="NR_CH_BANDWIDTH" />
							<DynamicAttributeValue source="SubCarrierSpacing" attributeName="NR_SUB_CARRIER_SPACING" />
							<DynamicAttributeValue source="BandRxChains" attributeName="NR_TUNE_NUM_RX_CHAIN" />
							<DynamicAttributeValue source="IsUplinkActive" attributeName="NR_UPLINK_ACTIVE" />
							<DynamicAttributeValue source="IsContCarrier" attributeName="NR_INTRA_CONT" />
							<DynamicAttributeValue source="IntraAssocCarrier" attributeName="NR_INTRA_ASSOC_CARRIER" />
							<DynamicAttributeValue source="UlStartRB" attributeName="NR_UL_RB_START" />
							<DynamicAttributeValue source="UlNumRB" attributeName="NR_UL_RB_NUMBER_OF" />
							<DynamicAttributeValue source="UlRBAllocation" attributeName="NR_RB_ALLOCATION" />
							<DynamicAttributeValue source="OfdmType" attributeName="NR_OFDM_TYPE" />
							<DynamicAttributeValue source="Modulation" attributeName="NR_UL_MODULATION_TYPE" />
							<DynamicAttributeValue source="DlPowerLevel" attributeName="NR_DL_POWER" />
							<DynamicAttributeValue source="BandPowerClass" attributeName="NR_UL_POWER_CLASS_OVERRIDE" />
							<Attributes>
								<Attribute name="NR_INIT_MODE" enabled="true">SET_VALUE</Attribute>
								<Attribute name="NR_CARRIER" enabled="true">PCC</Attribute>
								<Attribute name="NR_BAND" enabled="true">1</Attribute>
								<Attribute name="NR_SUB_BAND_ID" enabled="true">FULL</Attribute>
								<Attribute name="NR_SUB_BAND_UL_CHANNEL_RANGE" enabled="true"></Attribute>
								<Attribute name="NR_CH_BANDWIDTH" enabled="true">20</Attribute>
								<Attribute name="NR_SUB_CARRIER_SPACING" enabled="true">30</Attribute>
								<Attribute name="NR_OPT_CHANNEL" enabled="true">LOW</Attribute>
								<Attribute name="NR_TUNE_NUM_RX_CHAIN" enabled="true">2</Attribute>
								<Attribute name="NR_UPLINK_ACTIVE" enabled="true">true</Attribute>
								<Attribute name="NR_INTRA_CONT" enabled="true">false</Attribute>
								<Attribute name="NR_INTRA_ASSOC_CARRIER" enabled="true" />
								<Attribute name="NR_UL_RB_START" enabled="true">0</Attribute>
								<Attribute name="NR_UL_RB_NUMBER_OF" enabled="true">51</Attribute>
								<Attribute name="NR_RB_ALLOCATION" enabled="true">MANUAL</Attribute>
								<Attribute name="NR_OFDM_TYPE" enabled="true">CP</Attribute>
								<Attribute name="NR_UL_MODULATION_TYPE" enabled="true">QPSK</Attribute>
								<Attribute name="NR_DL_POWER" enabled="true">-120.0</Attribute>
								<Attribute name="NR_UL_POWER_CLASS_OVERRIDE" enabled="true">0</Attribute>
							</Attributes>
						</Algorithm>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<Attributes>
								<Attribute name="NR_SEGMENT_DURATION_MS" enabled="true">50</Attribute>
							</Attributes>
						</Algorithm>
					</Algorithms>
				</Segment>
			</Segments>
		</SegmentGroup>
		<SegmentGroup ID="SUB6_Measure">
			<Segments>
				<Segment enabled="true" name="Configure">
					<Algorithms>
						<Algorithm enabled="true" name="QSEQ_ALGORITHM_QUALCOMM_SUB6_MEASURE">
							<DynamicAttributeValue source="UlPowerLevel" attributeName="NR_UL_POWER" />
							<DynamicAttributeValue source="UlPowerLevel" attributeName="NR_UL_POWER_REF_LEVEL" />
							<DynamicAttributeValue source="Modulation" attributeName="NR_UL_MODULATION_TYPE" />
							<DynamicAttributeValue source="UlStartRB" attributeName="NR_UL_RB_START" />
							<DynamicAttributeValue source="UlNumRB" attributeName="NR_UL_RB_NUMBER_OF" />
							<DynamicAttributeValue source="NetSigValue" attributeName="NR_NS_VALUE" />
