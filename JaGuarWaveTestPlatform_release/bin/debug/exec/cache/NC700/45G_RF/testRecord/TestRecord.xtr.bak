							<DynamicAttributeValue source="Rx0AntNum" attributeName="NR_RX0_ANTENNA_NUMBER" />
							<DynamicAttributeValue source="Rx1Device" attributeName="NR_RX1_DEVICE" />
							<DynamicAttributeValue source="Rx1PathIndex" attributeName="NR_RX1_PATH_INDEX" />
							<DynamicAttributeValue source="Rx1SignalPath" attributeName="NR_RX1_SIGNAL_PATH" />
