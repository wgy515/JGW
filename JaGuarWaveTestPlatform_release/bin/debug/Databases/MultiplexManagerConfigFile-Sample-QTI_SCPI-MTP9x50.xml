<?xml version="1.0" encoding="utf-8"?>
<root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <MULTI_DUT_CONFIG>
    <MULTIPLEXERS>
      <MULTIPLEXER ID="1">
		
		<!-- Example 1  2 DUTs 2 Duplex Port on TE, Use 4 way splitter
		<ROUTING_CONFIG PORTS="WWAN_ANT0,WWAN_ANT1,WWAN_ANT2,WWAN_ANT3" 
		         BANDS="" 
				 DESCRIPTION="RF splitters" 
				 CALDB_TX_PATH_ID="5" 
				 CALDB_RX_PATH_ID="4" 
				 CALDB_TX_CONFIG_NAME="DONTCARE" 
				 CALDB_RX_CONFIG_NAME="DONTCARE" >
		1:1;
		2:2;
		</ROUTING_CONFIG>
		-->
		<!-- Example 1a  2 DUTs 1 Duplex Port on TE, Use 8 way splitter
		<ROUTING_CONFIG PORTS="WWAN_ANT0,WWAN_ANT1,WWAN_ANT2,WWAN_ANT3" 
						BANDS="" DESCRIPTION="Connect all 4 ports with a RF splitter" 
						CALDB_TX_PATH_ID="5" 
						CALDB_RX_PATH_ID="4" 
						CALDB_TX_CONFIG_NAME="DONTCARE" 
						CALDB_RX_CONFIG_NAME="DONTCARE" >
		1:1;
		1:1;
		</ROUTING_CONFIG>
		-->
		<!-- Example - 3 2 DUTs 8 Duplex Ports on TE, Do not use any splitter, Separate path loss for 4 RF Cables
		<ROUTING_CONFIG PORTS="WWAN_ANT0" 
		         BANDS="" 
				 DESCRIPTION="Connect ANT0 to TE port 1(DUT1), 5 (DUT2)" 
				 CALDB_TX_PATH_ID="5" 
				 CALDB_RX_PATH_ID="4" 
				 CALDB_TX_CONFIG_NAME="DONTCARE" 
				 CALDB_RX_CONFIG_NAME="DONTCARE">
		1:1;
		5:5;
		</ROUTING_CONFIG>
		<ROUTING_CONFIG PORTS="WWAN_ANT1" 
		         BANDS="" DESCRIPTION="Connect ANT1 to TE port 2(DUT1), 6 (DUT2)" 
				 CALDB_TX_PATH_ID="15" 
				 CALDB_RX_PATH_ID="14" 
				 CALDB_TX_CONFIG_NAME="DONTCARE" 
				 CALDB_RX_CONFIG_NAME="DONTCARE"> 
		2:2;
		6:6;
		</ROUTING_CONFIG>
		<ROUTING_CONFIG PORTS="WWAN_ANT2" 
		                BANDS="" 
						DESCRIPTION="Connect ANT2 to TE port 3(DUT1), 7 (DUT2)" 
						CALDB_TX_PATH_ID="25" 
						CALDB_RX_PATH_ID="24" 
						CALDB_TX_CONFIG_NAME="DONTCARE" 
						CALDB_RX_CONFIG_NAME="DONTCARE">
		3:3;
		7:7;
		</ROUTING_CONFIG>
		<ROUTING_CONFIG PORTS="WWAN_ANT3" 
		                BANDS="" DESCRIPTION="Connect ANT3 to TE port 4(DUT1), 8 (DUT2)" 
						CALDB_TX_PATH_ID="35" 
						CALDB_RX_PATH_ID="34" 
						CALDB_TX_CONFIG_NAME="DONTCARE" 
						CALDB_RX_CONFIG_NAME="DONTCARE">
		4:4;
		8:8;
		</ROUTING_CONFIG>
		-->
	
		<!-- Example - 4 2 DUTs 4 Duplex Ports on TE, Use splitter on ANT0+ANT1, ANT2, ANT3 + Connectivity -->
		<ROUTING_CONFIG PORTS="WWAN_ANT0,WWAN_ANT1" 
						BANDS="" DESCRIPTION="Connect ANT1/ANT2 to TE port 1(DUT1), 2 (DUT2)" 
						CALDB_TX_PATH_ID="5" 
						CALDB_RX_PATH_ID="4" 	
						CALDB_TX_CONFIG_NAME="DONTCARE" 
						CALDB_RX_CONFIG_NAME="DONTCARE">
		1:1;
		5:5;
		</ROUTING_CONFIG>
		<ROUTING_CONFIG PORTS="WWAN_ANT2" 
		                BANDS="" 
						DESCRIPTION="Connect ANT3 to TE port 2(DUT1), 5 (DUT2)" 
						CALDB_TX_PATH_ID="15" 
						CALDB_RX_PATH_ID="14"
						CALDB_TX_CONFIG_NAME="DONTCARE" 
						CALDB_RX_CONFIG_NAME="DONTCARE">
		2:2;
		6:6;
		</ROUTING_CONFIG>
		<ROUTING_CONFIG PORTS="WWAN_ANT3" BANDS="" 
						DESCRIPTION="Connect ANT4 to TE port 3(DUT1), 6 (DUT2)" 
						CALDB_TX_PATH_ID="25" 
						CALDB_RX_PATH_ID="24" 
						CAL_TX_PATH_NAME="DONTCARE"
						CAL_RX_PATH_NAME="DONTCARE">
		3:3;
		7:7;
		</ROUTING_CONFIG>
		<ROUTING_CONFIG PORTS="BT,WLAN,GNSS_RX0" 
		                BANDS="" 
						DESCRIPTION="Connectivity Antenna to this port" 
						CALDB_TX_PATH_ID="5" 
						CALDB_RX_PATH_ID="4" 
						CAL_TX_PATH_NAME="WCN"
						CAL_RX_PATH_NAME="WCN">
		4:4;
		8:8;
		</ROUTING_CONFIG>
		
		
        <!--
        <ROUTING_CONFIG PORTS="BT,GNSS_RX0,WLAN" BANDS="" DESCRIPTION="DUT 1(2):Connect WiFi/BT/GPS antenna to Port 3(4) on a QTI SCPI compliant call box">9:9;10:10;</ROUTING_CONFIG>
		-->
        <DRIVER_DLL>C:\Program Files (x86)\Qualcomm\QDART\bin\MCI_QTI_SCPI.dll</DRIVER_DLL>
        <BUS_CONFIG>GPIB0::20::INSTR</BUS_CONFIG>
        <SIMULATION_MODE>YES</SIMULATION_MODE>
      </MULTIPLEXER>
    </MULTIPLEXERS>
    <GROUPS>
		<!--MULTIPLEXER_TYPE is a bit combination flag of multiplex capability, 
		if set, bit 0 - to use antenna number configuration (WWAN_ANTx) instead of tech/band setting, 
		bit 1  - rx(downlink) broadcast, bit 2 - tx(uplink) switch path in list mode
		-->
      <GROUP ID="1">
        <DUT ID="1">
          <MULTIPLEXER_IDS>1</MULTIPLEXER_IDS>
          <MULTIPLEXER_PATHS>1</MULTIPLEXER_PATHS>
          <MULTIPLEXER_TYPE>1</MULTIPLEXER_TYPE>
        </DUT>
        <DUT ID="2">
          <MULTIPLEXER_IDS>1</MULTIPLEXER_IDS>
          <MULTIPLEXER_PATHS>2</MULTIPLEXER_PATHS>
          <MULTIPLEXER_TYPE>1</MULTIPLEXER_TYPE>
        </DUT>
        <DUT ID="3">
          <MULTIPLEXER_IDS>1</MULTIPLEXER_IDS>
          <MULTIPLEXER_PATHS>3</MULTIPLEXER_PATHS>
          <MULTIPLEXER_TYPE>1</MULTIPLEXER_TYPE>
        </DUT>
        <DUT ID="4">
          <MULTIPLEXER_IDS>1</MULTIPLEXER_IDS>
          <MULTIPLEXER_PATHS>4</MULTIPLEXER_PATHS>
          <MULTIPLEXER_TYPE>1</MULTIPLEXER_TYPE>		  
        </DUT>
      </GROUP>
    </GROUPS>
  </MULTI_DUT_CONFIG>
</root>