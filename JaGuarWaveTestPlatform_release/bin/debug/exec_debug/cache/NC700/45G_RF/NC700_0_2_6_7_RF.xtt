        <HiveProperties NodeType="TestProperty">
          <TestName>Power Supply On</TestName>
          <RealName>RFCal_PSOnOff</RealName>
          <Description>Turn On, Off, or toggle the Power Supply. Note that some parameters in this node are used globally, and some may be overriden by SUITEGlobalConfiguration test node. Check the individual params descriptions.</Description>
          <CheckStateTest>Unchecked</CheckStateTest>
          <IsLinkActive xsi:nil="true" />
          <LoggingEnabled>false</LoggingEnabled>
          <NodeRID>-1</NodeRID>
          <NumberOfTests>1</NumberOfTests>
          <Parameters>
            <ParameterCls>
              <Name>Phone Poweroff Method</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>0</Value>
              <Unit>Power supply OFF method: 0 = Power OFF, 1 = Set 0 Volts</Unit>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Output state</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>2</Value>
              <Unit>Output state : 0-OFF, 1-ON, 2-Toggle ON</Unit>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Power up delay</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>5000</Value>
              <Unit>Power up delay (msec)</Unit>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <Description>WARNING: SUITEGlobalConfiguration test node can override this param.If SUITEGlobalConfiguration has not run, this param will be used globally</Description>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Toggle delay</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>500</Value>
              <Unit>millisec</Unit>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <Description>WARNING: SUITEGlobalConfiguration test node can override this param.If SUITEGlobalConfiguration has not run, this param will be used globally</Description>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Store PS Toggle On TimeStamp</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>0</Value>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <Description>Default : 0 - Do not store, 1 - Store.
If stored a following test could use it to determine timing information for a reboot</Description>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Watch for Messages ?</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>0</Value>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <DisplayHint>4098</DisplayHint>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Text Marker</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value />
              <DataType>String</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <Description>Any Text to Log - Supports entries in printf( format, args ) style, where its entries correspond to the "format" part of printf. Supported printf place-holders are: %d,%f,%s; for int, double, and string. There can be many place-holders. Example entry: Marker :: c:\qcn_backup\%s. In this example "%s" will be replaced with the corresponding or equivalent key value in "Args" parameter and it will result in the corresponding marker in the log.</Description>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Marker Args</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value />
              <DataType>String</DataType>
              <Type>Input</Type>
              <ParentName>Text Marker</ParentName>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <Description>Supports entries in printf( format, args ) style, where its entries correspond to the "args" part of printf. A delimited list of keywords. Must have the same number of elements as the number of place-holders in "Command" param. Example entry: TESTTREEID. In this example "TESTTREEID" key will replace the "%s" found in "Command" param with the actual TESTTREEID of the tree used.</Description>
              <DisplayHint>1024</DisplayHint>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Use Config Lookup For Marker Args</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>0</Value>
              <Unit>NONE</Unit>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <ParentName>Text Marker</ParentName>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <DisplayHint>1282</DisplayHint>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>Enable DLF Logging</Name>
              <RealName />
              <NoOfElements>1</NoOfElements>
              <Value>0</Value>
              <UpperLimit>0</UpperLimit>
              <LowerLimit>0</LowerLimit>
              <DataType>Int</DataType>
              <Type>Input</Type>
              <EnableDataLoggingAsString>F</EnableDataLoggingAsString>
              <EnableChartingAsString>F</EnableChartingAsString>
              <UseRunTimeLimits>false</UseRunTimeLimits>
              <DisplayHint>4098</DisplayHint>
              <ArrayParameterRIDsAsString />
            </ParameterCls>
            <ParameterCls>
              <Name>File Name Marker</Name>
              <RealName />
