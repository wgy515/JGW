  <MULTI_DUT_CONFIG>
    <MULTIPLEXERS>
      <MULTIPLEXER ID="1">
	    <!-- Set the RoutingConfiguration string property.
		   * 
		   *		For example:
		   *		
		   *		RoutingConfiguration = "1,1,1;1,2,2" where
	  	   *		
	 	   *		";" delimits the groups of channel lists required to select different DUTs
		   *			For example:
		   *			"1,1,1" = Routing information set for DUT 1
		   *			"1,2,2" = Routing information set for DUT 2
		   *		
		   *		"," delimits the fields 	
         *     
         *      This set of information contains the 
         *           i. Slot Address
         *          ii. Input Port Value
         *         iii. Output Port Value
         *      corresponding to each DUT.
		 -->
        <ROUTING_CONFIG DESCRIPTION="CONNECT Antenna to Slot1" 
						PORTS="WCDMA_TX0,WCDMA_RX0,WCDMA_RX1,CDMA_TX0,CDMA_RX0,CDMA_RX1,LTE_TX0,LTE_RX0,LTE_RX1,C1_LTE_RX0,C1_LTE_RX1,GSM_TX0,GSM_RX0,C1_GSM_TX0,C1_GSM_RX0,TDSCDMA_TX0,TDSCDMA_RX0,TDSCDMA_RX1"
						CALDB_TX_PATH_ID="5" 
						CALDB_RX_PATH_ID="4" 
						CALDB_TX_CONFIG_NAME="DONTCARE" 
						CALDB_RX_CONFIG_NAME="DONTCARE" >1,1,1;1,2,2</ROUTING_CONFIG>
        <DRIVER_DLL>C:\Program Files (x86)\Qualcomm\qdart\bin\MCI_Anritsu_MT8870A.dll</DRIVER_DLL>
        <BUS_CONFIG>GPIB0::3::INSTR</BUS_CONFIG>
        <SIMULATION_MODE>NO</SIMULATION_MODE>
